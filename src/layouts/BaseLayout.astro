---
// Base Layout — supports bilingual (zh/en)
// Phase 0 Batch 2: SEO meta + JSON-LD Organization/WebSite added.
// Phase 0 Batch 3: Vercel Analytics added.
// Phase 1: html lang uses BCP-47 (zh-HK / en), hreflang alternate tags emit
// per-page, LanguageSwitcher component in nav.
import Analytics from '@vercel/analytics/astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import '../styles/brand.css';  // 全域品牌字體（唔可以放 <style> 內，Astro 會加 component scope）
import '../styles/ui-v2.css';  // 視覺系統 v2（字階放大／控制件尺寸／卡片／動態）— 必須後於 brand.css

export interface Props {
  title: string;
  description?: string;
  /** When 'article', og:type=article. For health article detail pages. */
  ogType?: 'website' | 'article';
  /** Absolute or site-relative path to og:image. Defaults to /og-image.png. */
  ogImage?: string;
  /** JSON-LD document blocks to inject alongside the default Organization + WebSite. */
  jsonLd?: object | object[];
  /** Optional override for og:locale when lang is not enough. */
  ogLocale?: string;
  /** ISO date string for Article schema. */
  publishedTime?: string;
  /** ISO date string for Article schema. */
  modifiedTime?: string;
  lang?: 'zh' | 'en';
  /**
   * Set true when this page has no English equivalent (e.g. an untranslated
   * zh-only health article). Suppresses the en hreflang alternate so search
   * engines don't index a 404. Defaults to false (emit both zh + en).
   * Phase 2: src/pages/health/[slug].astro sets this when content_html_en
   * is empty.
   */
  noEnAlternate?: boolean;
  /**
   * Set true when the page is too thin to deserve index slots (e.g. area
   * pages with < 3 nearby restaurants). Emits <meta name="robots"
   * content="noindex,follow"> so search engines follow links but don't
   * index the page itself. Page still kept + still in sitemap.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage,
  jsonLd,
  ogLocale,
  publishedTime,
  modifiedTime,
  lang = 'zh',
  noEnAlternate = false,
  noindex = false,
} = Astro.props;
const isZh = lang === 'zh';

// Site constants — single source of truth, drives canonical + OG URLs.
const SITE = Astro.site?.toString().replace(/\/$/, '') || 'https://hk-pet-portal.vercel.app';
const pathName = Astro.url.pathname;
// Strip query + trailing slash to normalize: /restaurants/ -> /restaurants; leave '/' alone.
const normalizedPath = pathName === '/' ? '/' : pathName.replace(/\/$/, '');

// Derive the locale-free path (drop the /en prefix when present) so we can
// re-apply the correct prefix for hreflang alternates. This prevents the
// double-prefix bug (`/en/en/about`) where the en page's pathname already
// contains `/en` and a naive prepend would duplicate it.
const stripEn = (p: string): string => {
  if (p === '/en' || p === '/en/') return '/';
  if (p.startsWith('/en/')) return p.slice(3) || '/';
  return p;
};
const localeFreePath = stripEn(normalizedPath);
const zhPath = localeFreePath; // zh = no prefix (defaultLocale, prefixDefaultLocale: false)
const enPath = localeFreePath === '/' ? '/en' : `/en${localeFreePath}`;

const fullUrl = `${SITE}${normalizedPath}`;

// Nav active state — exact match or a sub-path of that section (/restaurants/123 → 餐廳 亮起)
const isCurrent = (href: string): boolean => {
  if (href === '/') return normalizedPath === '/';
  if (href === '/en') return normalizedPath === '/en' || normalizedPath === '/en/';
  return normalizedPath === href || normalizedPath.startsWith(`${href}/`);
};

// OG image: explicit override wins; otherwise default to site asset.
const ogImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`)
  : `${SITE}/og-image.png`;

// Locale default per language; allow override.
const resolvedLocale = ogLocale || (isZh ? 'zh_HK' : 'en_HK');

const fallbackZh = '香港寵物友善資訊平台 — 狗餐廳搜尋、健康知識、寵物資訊';
const fallbackEn = 'HK Pet Information Portal — Dog-friendly restaurants, health library, pet news';
const resolvedDescription = description || (isZh ? fallbackZh : fallbackEn);

// JSON-LD builders ------------------------------------------------------------
const orgLd: object = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'HK Pet Portal',
  url: SITE,
  logo: `${SITE}/logo.png`,
  sameAs: [],
};
const websiteLd: object = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'HK Pet Portal',
  url: SITE,
  inLanguage: isZh ? 'zh-HK' : 'en-HK',
};
const baseLdBlocks: object[] = [orgLd, websiteLd];
const extraLd: object[] = Array.isArray(jsonLd)
  ? jsonLd
  : jsonLd
  ? [jsonLd]
  : [];
const allLd = [...baseLdBlocks, ...extraLd];
---

<!DOCTYPE html>
<html lang={isZh ? 'zh-HK' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | HK Pet Portal</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={fullUrl} />

    <!-- hreflang alternates (Phase 1 i18n). Every page declares its zh-HK and
         en equivalents. x-default points at the zh canonical (this is the
         default locale per astro.config.mjs). The en equivalent uses the
         /en/{rest-of-path} convention so /restaurants → /en/restaurants. -->
    <link rel="alternate" hreflang="zh-HK" href={`${SITE}${zhPath}`} />
    {!noEnAlternate && <link rel="alternate" hreflang="en" href={`${SITE}${enPath}`} />}
    <link rel="alternate" hreflang="x-default" href={`${SITE}${zhPath}`} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <!-- Open Graph (Phase 0 Batch 2) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="HK Pet Portal" />
    <meta property="og:title" content={`${title} | HK Pet Portal`} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} | HK Pet Portal`} />
    <meta property="og:locale" content={resolvedLocale} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter card (Phase 0 Batch 2) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | HK Pet Portal`} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=LXGW+WenKai+TC:wght@400;700&family=Noto+Sans+HK:wght@400;500;700;900&display=swap"
    />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=LXGW+WenKai+TC:wght@400;700&family=Noto+Sans+HK:wght@400;500;700;900&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#7C3AED" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicons/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicons/favicon-64x64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <style>
      @import "tailwindcss";
      @theme {
        /* 紫曜淺色組（token 來源：nexi-design-system/tokens-light.css）
           原則：白底為主，紫 #8B5CF6 只做 accent（CTA／選中／關鍵數字） */
        --color-brand: #7C3AED;
        --color-brand-dark: #6D28D9;
        --color-brand-light: #F1EDFF;
        --color-brand-deep: #5B21B6;
        --color-brand-coral: #DB2777;
        --color-near-black: #1E1B2E;
        --color-warm-white: #FBF9FF;
        --color-gray-900: #1E1B2E;
        --color-gray-700: #3A3350;
        --color-gray-500: #4B4661;
        --color-gray-300: #6E6688;
        --color-gray-100: #EDE9FE;
        --color-gray-50: #F5F3FF;
        --color-paw-orange: #B45309;
        --color-vet-blue: #2563EB;
        --color-healthy-green: #047857;
        --color-closed-red: #DC2626;
      }
      body { font-family: 'Noto Sans HK', system-ui, sans-serif; color: var(--color-near-black); background: white; margin: 0; }
      /* ux: keyboard focus visibility — keyboard-only, not mouse */
      :where(a, button, input, select, textarea, [tabindex]):focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; border-radius: 4px; }
      /* ux: respect reduced motion globally */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>

    <!-- JSON-LD: Organization + WebSite (always) + page-specific blocks (Phase 0 Batch 2) -->
    {allLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Navigation -->
    <nav class="nav-v2 sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-gray-100">
      <div class="max-w-6xl mx-auto px-3 md:px-4 h-14 md:h-16 flex items-center justify-between gap-2">
        <a href={isZh ? '/' : '/en'} class="footer-brand flex items-center gap-2 no-underline shrink-0 group">
          <img src="/logo_nav.png" alt="HK Pet Portal" width="96" height="64" decoding="async" class="h-10 md:h-11 w-auto transition-transform duration-200 group-hover:scale-105" />
          <span class="brand-name hidden sm:inline">HK Pet Portal</span>
        </a>
        <div class="overflow-x-auto scrollbar-hide -mr-3 md:mr-0">
          <div class="flex items-center gap-1.5 md:gap-2.5 px-3 md:px-0">
            <a href={isZh ? '/restaurants' : '/en/restaurants'}
               class:list={['nav-link', { 'is-current': isCurrent(isZh ? '/restaurants' : '/en/restaurants') }]}><span class="nav-emoji" aria-hidden="true">🍽️</span> {isZh ? '餐廳' : 'Restaurants'}</a>
            <a href={isZh ? '/map' : '/en/map'}
               class:list={['nav-link', { 'is-current': isCurrent(isZh ? '/map' : '/en/map') }]}><span class="nav-emoji" aria-hidden="true">🗺️</span> {isZh ? '地圖' : 'Map'}</a>
            <a href={isZh ? '/health' : '/en/health'}
               class:list={['nav-link', { 'is-current': isCurrent(isZh ? '/health' : '/en/health') }]}><span class="nav-emoji" aria-hidden="true">📚</span> {isZh ? '健康' : 'Health'}</a>
            <a href={isZh ? '/news' : '/en/news'}
               class:list={['nav-link', { 'is-current': isCurrent(isZh ? '/news' : '/en/news') }]}><span class="nav-emoji" aria-hidden="true">📰</span> {isZh ? '資訊' : 'News'}</a>
            <LanguageSwitcher lang={lang} currentPath={pathName} />
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Vercel Analytics (Phase 0 Batch 3) -->
    <Analytics />

    <!-- 動態層 v2：進場 reveal（stagger）／數字 count-up／導覽列滾動影／按壓回饋
         全部受 prefers-reduced-motion 控制；3.5 秒後強制顯示所有未進場元素（保險）。 -->
    <script>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 1) 導覽列滾動影
        const nav = document.querySelector('.nav-v2');
        if (nav) {
          const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 6);
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }
        if (reduce) return;

        // 2) 收集要進場嘅元素：自己標記嘅 + 常見容器嘅直接子項
        const sel = [
          '[data-reveal]',
          '.list-card', '.stat-tile', '.card', '.health-tile',
          'main section .grid > *',
          'main section ul > li',
          'article > h2', 'article > p', 'article > ul', 'article > blockquote', 'article > figure',
        ].join(',');
        const nodes = Array.from(document.querySelectorAll(sel)).filter((el) => {
          if (el.closest('.reveal')) return false;
          const r = el.getBoundingClientRect();
          return r.width > 0 || r.height > 0;
        });
        nodes.forEach((el) => el.classList.add('reveal'));

        const show = (el) => {
          el.classList.add('is-in');
        };
        if (!('IntersectionObserver' in window)) {
          nodes.forEach(show);
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (!e.isIntersecting) return;
                const parent = e.target.parentElement;
                let i = 0;
                if (parent) i = Array.from(parent.children).indexOf(e.target);
                const delay = Math.min(i, 6) * 55;
                window.setTimeout(() => show(e.target), delay);
                io.unobserve(e.target);
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
          );
          nodes.forEach((el) => io.observe(el));
          // 3) 保險：3.5s 後仍未顯示嘅一律顯示（例如在 hidden 容器內）
          window.setTimeout(() => nodes.forEach(show), 3500);
        }

        // 4) 數字 count-up（統計磚／任何 .js-count）
        const fmt = (n, grouped) => (grouped ? n.toLocaleString('en-US') : String(n));
        document.querySelectorAll('.st-num, .js-count').forEach((el) => {
          const raw = (el.textContent || '').trim();
          if (!/^\d{1,3}(,\d{3})*$|^\d+$/.test(raw)) return;
          const target = parseInt(raw.replace(/,/g, ''), 10);
          if (!Number.isFinite(target) || target < 20 || target > 200000) return;
          const grouped = raw.includes(',');
          let started = false;
          const run = () => {
            if (started) return;
            started = true;
            const t0 = performance.now();
            const dur = 850;
            const tick = (t) => {
              const p = Math.min(1, (t - t0) / dur);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = fmt(Math.round(target * eased), grouped);
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          };
          if ('IntersectionObserver' in window) {
            const io2 = new IntersectionObserver(
              (entries) => entries.forEach((e) => { if (e.isIntersecting) { run(); io2.unobserve(e.target); } }),
              { threshold: 0.4 }
            );
            io2.observe(el);
          } else {
            run();
          }
        });
      })();
    </script>

    <!-- Footer -->
    <footer class="bg-warm-white border-t border-gray-100 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h4 class="font-semibold text-sm text-gray-500 mb-3 flex items-center gap-2">
              <img src="/logo_nav.png" alt="HK Pet Portal" width="96" height="64" decoding="async" class="h-9 md:h-10 w-auto" />
              <span>HK Pet Portal</span>
            </h4>
            <p class="text-sm text-gray-500 leading-relaxed">
              {isZh ? '香港寵物友善資訊平台 — 等你可以同毛孩一齊探索香港。' : 'Hong Kong pet-friendly information platform — explore HK with your furry friend.'}
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-sm text-gray-500 mb-3">
              {isZh ? '快速連結' : 'Quick Links'}
            </h4>
            <div class="flex flex-col gap-2 text-sm text-gray-500">
              <a
                href={isZh
                  ? 'https://www.fehd.gov.hk/tc_chi/licensing/dog_restaurants/dog_restaurants_list.html'
                  : 'https://www.fehd.gov.hk/english/licensing/dog_restaurants/dog_restaurants_list.html'}
                target="_blank"
                rel="noopener"
                class="hover:text-brand transition-colors no-underline"
              >
                {isZh ? '食環署官方名單 ↗' : 'FEHD Official List ↗'}
              </a>
              <a href={isZh ? '/about' : '/en/about'} class="hover:text-brand transition-colors no-underline">
                {isZh ? '關於我們' : 'About Us'}
              </a>
              <a href={isZh ? '/terms' : '/en/terms'} class="hover:text-brand transition-colors no-underline">
                {isZh ? '免責聲明' : 'Disclaimer'}
              </a>
            </div>
          </div>
          <div>
            <h4 class="font-semibold text-sm text-gray-500 mb-3">
              {isZh ? '免責聲明' : 'Disclaimer'}
            </h4>
            <p class="text-xs text-gray-500 leading-relaxed">
              {isZh ? '餐廳資料來自食環署公開名單。健康資訊僅供參考，如有健康問題請諮詢註冊獸醫。' : 'Restaurant data from FEHD public list. Health info for reference only. Consult your vet for medical advice.'}
            </p>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-gray-100 text-center text-xs text-gray-500">
          {isZh ? '© 2026 HK Pet Portal。部分類型資料來自 OpenStreetMap（ODbL）。' : '© 2026 HK Pet Portal. Some type data from OpenStreetMap (ODbL).'}
        </div>
      </div>
    </footer>
  </body>
</html>
