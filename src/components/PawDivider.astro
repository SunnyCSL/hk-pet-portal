---
/**
 * PawDivider — a subtle monochrome decorative divider.
 * Three paw prints (small, medium, large center, medium) in #B0B0B0.
 * Centered horizontally with generous vertical margin.
 * Pure monochrome — no brand green, no emoji.
 * Decorative only: aria-hidden="true".
 */
---

<div
  class="flex items-center justify-center gap-3 md:gap-4 my-8 md:my-10 select-none"
  aria-hidden="true"
>
  <!-- Small paw -->
  <svg
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="text-[#B0B0B0]"
    xmlns="http://www.w3.org/2000/svg"
  >
    <ellipse cx="12" cy="15.5" rx="4.2" ry="3.6" />
    <ellipse cx="6.5" cy="10.5" rx="1.6" ry="2.1" />
    <ellipse cx="17.5" cy="10.5" rx="1.6" ry="2.1" />
    <ellipse cx="9" cy="6.5" rx="1.5" ry="1.9" />
    <ellipse cx="15" cy="6.5" rx="1.5" ry="1.9" />
  </svg>

  <!-- Medium paw -->
  <svg
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="text-[#B0B0B0]"
    xmlns="http://www.w3.org/2000/svg"
  >
    <ellipse cx="12" cy="15.5" rx="4.2" ry="3.6" />
    <ellipse cx="6.5" cy="10.5" rx="1.6" ry="2.1" />
    <ellipse cx="17.5" cy="10.5" rx="1.6" ry="2.1" />
    <ellipse cx="9" cy="6.5" rx="1.5" ry="1.9" />
    <ellipse cx="15" cy="6.5" rx="1.5" ry="1.9" />
  </svg>

  <!-- Large center paw -->
  <svg
    width="36"
    height="36"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="text-[#B0B0B0]"
    xmlns="http://www.w3.org/2000/svg"
  >
    <ellipse cx="12" cy="15.5" rx="4.2" ry="3.6" />
    <ellipse cx="6.5" cy="10.5" rx="1.6" ry="2.1" />
    <ellipse cx="17.5" cy="10.5" rx="1.6" ry="2.1" />
    <ellipse cx="9" cy="6.5" rx="1.5" ry="1.9" />
    <ellipse cx="15" cy="6.5" rx="1.5" ry="1.9" />
  </svg>

  <!-- Medium paw -->
  <svg
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="text-[#B0B0B0]"
    xmlns="http://www.w3.org/2000/svg"
  >
    <ellipse cx="12" cy="15.5" rx="4.2" ry="3.6" />
    <ellipse cx="6.5" cy="10.5" rx="1.6" ry="2.1" />
    <ellipse cx="17.5" cy="10.5" rx="1.6" ry="2.1" />
    <ellipse cx="9" cy="6.5" rx="1.5" ry="1.9" />
    <ellipse cx="15" cy="6.5" rx="1.5" ry="1.9" />
  </svg>
</div>