---
import BaseLayout from '../../layouts/BaseLayout.astro';
import mealPlans from '../../data/meal-plans.json';

const allTags = [...new Set(mealPlans.flatMap(m => m.health_tags))].sort();
const allProtein = [...new Set(mealPlans.map(m => m.protein_source))].sort();
const tagFilter = Astro.url.searchParams.get('tag') || '';
const proteinFilter = Astro.url.searchParams.get('protein') || '';

let filtered = mealPlans;
if (tagFilter) filtered = filtered.filter(m => m.health_tags.includes(tagFilter));
if (proteinFilter) filtered = filtered.filter(m => m.protein_source.includes(proteinFilter));
---

<BaseLayout title="🥘 鮮食餐單庫" lang="zh">
  <div class="max-w-4xl mx-auto px-4 py-6 md:py-8">
    <h1 class="text-xl md:text-2xl font-bold text-near-black mb-1">🥘 鮮食餐單庫</h1>
    <p class="text-sm text-gray-400 mb-3">為狗狗健康設計嘅鮮食餐單 — 分享你嘅 recipe，或者搵適合嘅餐單</p>

    <div class="flex gap-2 mb-5 flex-wrap">
      <a href="/meals/recommend/" class="bg-brand text-white px-4 py-2 rounded-xl text-sm font-medium no-underline hover:bg-brand/90 transition">
        ✨ 即時餐單推薦
      </a>
      <a href="/meals/" class="bg-gray-50 text-gray-500 px-4 py-2 rounded-xl text-sm font-medium no-underline hover:bg-gray-100 transition">
        📋 全部餐單 ({mealPlans.length})
      </a>
    </div>

    <!-- Filters -->
    <div class="flex gap-2 mb-4 flex-wrap overflow-x-auto scrollbar-hide">
      <a href="/meals/" class={`shrink-0 px-3 py-1 rounded-full text-xs font-medium no-underline transition ${!tagFilter && !proteinFilter ? 'bg-brand text-white' : 'bg-gray-50 text-gray-500 hover:bg-gray-100'}`}>全部</a>
      {allTags.map(t => (
        <a href={`/meals/?tag=${encodeURIComponent(t)}`}
          class={`shrink-0 px-3 py-1 rounded-full text-xs font-medium no-underline transition ${tagFilter === t ? 'bg-brand text-white' : 'bg-gray-50 text-gray-500 hover:bg-gray-100'}`}
        >{t}</a>
      ))}
    </div>

    <!-- Meal grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {filtered.map(m => (
        <a href={`/meals/${m.id}`}
          class="group bg-white rounded-xl p-4 border border-gray-100 hover:border-brand/30 hover:shadow-sm transition-all no-underline"
        >
          <div class="flex items-start gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 mb-1">
                <h2 class="text-sm md:text-base font-semibold text-near-black group-hover:text-brand transition-colors">{m.name}</h2>
                <span class="text-[10px] bg-gray-50 text-gray-400 px-1.5 py-0.5 rounded">{m.difficulty}</span>
              </div>
              <p class="text-xs text-gray-400 mb-2 leading-relaxed">{m.description}</p>
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-[10px] bg-brand-light text-brand/80 px-2 py-0.5 rounded-full font-medium">{m.protein_source}</span>
                <span class="text-[10px] text-gray-300">{m.prep_time}</span>
                <span class="text-[10px] text-gray-300">👤 {m.author}</span>
              </div>
              <div class="flex gap-1 mt-1.5 flex-wrap">
                {m.health_tags.slice(0, 3).map(t => (
                  <span class="text-[9px] bg-gray-50 text-gray-400 px-1.5 py-0.5 rounded-full">{t}</span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    {filtered.length === 0 && (
      <p class="text-center text-gray-400 py-10">搵唔到符合條件嘅餐單</p>
    )}

    <div class="mt-8 pt-4 border-t border-gray-100">
      <p class="text-xs text-gray-300 text-center">想分享你嘅餐單？聯絡 Sunny 話俾我知 😎</p>
    </div>
  </div>
</BaseLayout>
