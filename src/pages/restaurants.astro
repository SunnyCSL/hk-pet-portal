---
import BaseLayout from '../layouts/BaseLayout.astro';
import restaurants from '../data/restaurants.json';
import stats from '../data/restaurant-stats.json';

const districts = [...new Set(restaurants.map((r: { district: string }) => r.district))].sort();

// Phase 2 (fix/restaurant-search-v2): unified search index across all 906 records.
// Build-time: each record gets a precomputed `search_key` = base + extras.
// Extras include SUB_AREAS detected from address+name AND any alias group
// whose `keys` (real address/name substrings) match the base.
// First 50 cards keep SSR (data-key/data-name/data-district/data-addr), island
// holds 51..906 as compact arrays so the rendered HTML stays compact while the
// client can do proper token + AND search across the whole dataset.
const PAGE_SIZE = 50;
const STATIC_COUNT = 50;

// Sub-area names (shared with client). Order matters: longer/more specific
// first so e.g. '西九龍' wins over '九龍' if both ever overlapped.
const SUB_AREAS = [
  '馬鞍山','科學園','白石角',
  '香港仔','黃竹坑','海洋公園','淺水灣','赤柱','薄扶林','數碼港','鴨脷洲',
  '中環','上環','西營盤','堅尼地城','石塘咀','半山','山頂','金鐘',
  '銅鑼灣','跑馬地','大坑','天后',
  '北角','鰂魚涌','太古','西灣河','筲箕灣','柴灣',
  '尖沙咀','尖東','佐敦','油麻地',
  '旺角','太子','大角咀',
  '長沙灣','荔枝角','美孚',
  '土瓜灣','紅磡','何文田','啟德',
  '九龍灣','觀塘','牛頭角','藍田','油塘',
  '深井','馬灣','荃灣',
  '屯門','黃金海岸',
  '元朗','天水圍','錦田',
  '上水','粉嶺',
  '大埔',
  '沙田','大圍','火炭',
  '西貢','將軍澳','坑口','寶琳','調景嶺','康城','清水灣',
  '葵涌','葵芳','青衣',
  '東涌','愉景灣','迪士尼','機場','大澳','長洲','南丫島','坪洲',
];

// Alias groups: queries in `names` should match records whose address/name
// contains any of `keys`. Both sides lowercased.
const ALIAS_GROUPS: Array<{ names: string[]; keys: string[] }> = [
  { names: ['奧運','olympic','olympian'], keys: ['奧海城','海泓道','大角咀','利奧坊','海帆道','匯翔道','櫻桃街','奧柏'] },
  { names: ['旺角東'], keys: ['旺角','太子'] },
  { names: ['西九龍','west kowloon','elements','圓方'], keys: ['西九龍','柯士甸','圓方','elements'] },
  { names: ['科學園','science park'], keys: ['科學園','白石角'] },
  { names: ['數碼港','cyberport'], keys: ['數碼港','薄扶林'] },
  { names: ['太古'], keys: ['太古','鰂魚涌'] },
  { names: ['將軍澳'], keys: ['將軍澳','坑口','寶琳','調景嶺','康城'] },
  { names: ['東涌'], keys: ['東涌','愉景灣'] },
  { names: ['馬鞍山'], keys: ['馬鞍山','烏溪沙'] },
  { names: ['機場','airport'], keys: ['機場','赤鱲角','航天城'] },
  { names: ['迪士尼','disneyland'], keys: ['迪士尼','竹篙灣'] },
  { names: ['中文大學','cuhk'], keys: ['中文大學','馬料水'] },
  { names: ['香港科技大學','hkust'], keys: ['香港科技大學','清水灣'] },
  { names: ['香港大學','hku'], keys: ['香港大學','薄扶林'] },
  { names: ['海洋公園','ocean park'], keys: ['海洋公園','黃竹坑'] },
  { names: ['黃金海岸','gold coast'], keys: ['黃金海岸','青山公路'] },
  { names: ['天水圍'], keys: ['天水圍','天慈'] },
];

function detectSubAreasFromBase(baseLower: string): string[] {
  const hits: string[] = [];
  for (const s of SUB_AREAS) {
    if (baseLower.includes(s)) hits.push(s);
  }
  return hits;
}

function detectAliasesFromBase(baseLower: string): string[] {
  const hits: string[] = [];
  for (const g of ALIAS_GROUPS) {
    if (g.keys.some(k => baseLower.includes(k))) {
      for (const n of g.names) hits.push(n);
    }
  }
  return hits;
}

function buildSearchKey(r: any): string {
  const base = [r.name_zh || '', r.name_en || '', r.address || '', r.district || '']
    .join(' ')
    .toLowerCase();
  const extras = [...detectSubAreasFromBase(base), ...detectAliasesFromBase(base)];
  // Dedupe (rare but possible overlap) and join with single spaces
  const seen = new Set<string>();
  const merged: string[] = [];
  for (const x of extras) {
    if (!seen.has(x)) { seen.add(x); merged.push(x); }
  }
  return base + ' ' + merged.join(' ');
}

type StaticCard = { id: number; name_zh: string; name_en: string; district: string; address: string; key: string };
type IslandRow = [number, string, string, string, string, string];

const firstPage: StaticCard[] = (restaurants as any[]).slice(0, STATIC_COUNT).map((r: any) => ({
  id: r.id,
  name_zh: r.name_zh || r.name_en || '',
  name_en: r.name_en || r.name_zh || '',
  district: r.district || '',
  address: r.address || '',
  key: buildSearchKey(r),
}));

const restData: IslandRow[] = (restaurants as any[]).slice(STATIC_COUNT).map((r: any) => {
  const base = [r.name_zh || '', r.name_en || '', r.address || '', r.district || ''].join(' ').toLowerCase();
  const extras = [...detectSubAreasFromBase(base), ...detectAliasesFromBase(base)];
  const seen = new Set<string>();
  const merged: string[] = [];
  for (const x of extras) {
    if (!seen.has(x)) { seen.add(x); merged.push(x); }
  }
  return [r.id, r.name_zh || r.name_en || '', r.name_en || r.name_zh || '', r.district || '', r.address || '', merged.join(' ')];
});
---

<BaseLayout title="🍽️ 餐廳搜尋" lang="zh">
  <div class="max-w-4xl mx-auto px-4 py-6 md:py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-3">
        <h1 class="text-xl md:text-2xl font-bold text-near-black">🍽️ 狗友善餐廳</h1>
        <span class="text-sm text-gray-500 bg-gray-50 px-2.5 py-0.5 rounded-full" id="result-count">{restaurants.length} 間</span>
      </div>
      <a href="/restaurants" class="text-xs text-gray-500 hover:text-brand no-underline hidden" id="clear-filter">清除篩選</a>
    </div>

    <!-- Search bar -->
    <div class="flex gap-2 mb-5">
      <div class="flex-1 flex gap-2">
        <input type="text" id="search-input" placeholder="搜尋餐廳、地區..."
          class="flex-1 min-w-0 px-3.5 py-2 text-sm border border-gray-100 rounded-lg outline-none focus:border-brand/50 bg-white"
        />
        <button onclick="filterList()" class="bg-brand text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700 transition-colors shrink-0">🔍</button>
      </div>
    </div>

    <!-- District pills -->
    <div class="overflow-x-auto -mx-4 px-4 mb-5 scrollbar-hide">
      <div class="flex gap-1.5 w-max md:w-auto md:flex-wrap">
        <a href="/restaurants" onclick="setDistrict(''); return false;"
          class="shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-brand text-white"
          id="pill-all">全部</a>
        {districts.map((d: string) => (
          <a href={`/restaurants?district=${encodeURIComponent(d)}`} onclick={`setDistrict('${d}'); return false;`}
            class="shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
            id={`pill-${d.replace(/\s/g, '')}`}
          >{d}</a>
        ))}
      </div>
    </div>

    <!-- Results list — first 50 are server-rendered for SEO; rest are JS-rendered into this same wrapper -->
    <div id="restaurant-list" class="flex flex-col gap-2">
      {firstPage.map((r: StaticCard) => (
        <a href={`/restaurants/${r.id}`}
          class="restaurant-item group bg-white rounded-xl px-4 py-3 border border-gray-100 hover:border-brand/30 hover:shadow-sm transition-all no-underline"
          data-name={(r.name_zh || r.name_en || '').toLowerCase()}
          data-district={r.district}
          data-addr={(r.address || '').toLowerCase()}
          data-key={r.key}
        >
          <div class="flex items-center gap-3">
            <div class="w-1 h-10 bg-brand/20 rounded-full shrink-0"></div>
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold text-sm md:text-base text-near-black group-hover:text-brand transition-colors truncate">
                {r.name_zh || r.name_en || `${r.district}狗友善餐廳`}
              </h3>
              <p class="text-xs text-gray-500 mt-0.5 truncate">
                <span class="inline-flex items-center gap-1">
                  <span class="text-gray-300">📍</span> <span class="sub-area-label" data-addr={r.address} data-name={r.name_zh||''}>{r.district}</span>
                </span>
                <span class="mx-1.5 text-gray-200">·</span>
                <span class="text-gray-300">{r.address}</span>
              </p>
            </div>
            <div class="text-gray-300 group-hover:text-brand transition-colors shrink-0">
              <span class="text-xs">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Pagination UI -->
    <nav id="pager" class="flex items-center justify-center gap-1 mt-6 text-sm select-none" aria-label="餐廳分頁">
      <button id="pg-prev" type="button" class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-500 hover:border-brand/40 disabled:opacity-30 disabled:cursor-not-allowed" disabled>← 上一頁</button>
      <span id="pg-info" class="px-2 text-gray-500"><span id="pg-current">1</span> / <span id="pg-total">19</span></span>
      <button id="pg-next" type="button" class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-500 hover:border-brand/40 disabled:opacity-30 disabled:cursor-not-allowed">下一頁 →</button>
    </nav>

    <!-- Empty state -->
    <div id="empty-state" class="text-center py-16 text-gray-500 hidden">
      <div class="text-4xl mb-3">🔍</div>
      <p class="text-sm">搵唔到相關餐廳</p>
      <a href="/restaurants" onclick="resetFilter(); return false;" class="text-brand text-sm hover:underline mt-2 inline-block">清除篩選重新搜尋</a>
    </div>
  </div>

  <!-- fix/restaurant-search-v2: data island for JS pagination. Compact array form
       [id, name_zh, name_en, district, address, extras] so the index stays small
       while making address + sub-area labels searchable from the client. -->
  <script type="application/json" id="rest-data" set:html={JSON.stringify({ restaurants: restData })} />

  <script is:inline>
  // Sub-area names used to compute the search key (kept in sync with the SSR
  // frontmatter). Order matters: longer/more specific first.
  var SUB_AREAS = [
    '馬鞍山','科學園','白石角',
    '香港仔','黃竹坑','海洋公園','淺水灣','赤柱','薄扶林','數碼港','鴨脷洲',
    '中環','上環','西營盤','堅尼地城','石塘咀','半山','山頂','金鐘',
    '銅鑼灣','跑馬地','大坑','天后',
    '北角','鰂魚涌','太古','西灣河','筲箕灣','柴灣',
    '尖沙咀','尖東','佐敦','油麻地',
    '旺角','太子','大角咀',
    '長沙灣','荔枝角','美孚',
    '土瓜灣','紅磡','何文田','啟德',
    '九龍灣','觀塘','牛頭角','藍田','油塘',
    '深井','馬灣','荃灣',
    '屯門','黃金海岸',
    '元朗','天水圍','錦田',
    '上水','粉嶺',
    '大埔',
    '沙田','大圍','火炭',
    '西貢','將軍澳','坑口','寶琳','調景嶺','康城','清水灣',
    '葵涌','葵芳','青衣',
    '東涌','愉景灣','迪士尼','機場','大澳','長洲','南丫島','坪洲',
  ];

  function detectSubArea(addr, name) {
    var combined = (addr || '') + ' ' + (name || '');
    for (var i = 0; i < SUB_AREAS.length; i++) {
      if (combined.indexOf(SUB_AREAS[i]) !== -1) return SUB_AREAS[i];
    }
    return null;
  }

  var PAGE_SIZE = 50;

  // Helper: safe attribute setter (data-key values contain spaces + punctuation
  // so we still rely on getAttribute — escapeHtml only matters when constructing
  // HTML from user-supplied strings via innerHTML).
  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // ---- Build the unified index (906 entries, original dataset order) ----
  // Each entry: { id, key, district, name_zh, name_en, address }
  var INDEX = [];
  function buildKey(nameZh, nameEn, address, district, extras) {
    var base = [nameZh || '', nameEn || '', address || '', district || '']
      .join(' ')
      .toLowerCase();
    return base + ' ' + (extras || '');
  }

  // 1) Read static SSR cards (first 50) — prefer precomputed data-key.
  var staticEls = Array.prototype.slice.call(document.querySelectorAll('#restaurant-list .restaurant-item:not([data-island-card="1"])'));
  for (var s = 0; s < staticEls.length; s++) {
    var el = staticEls[s];
    var idMatch = (el.getAttribute('href') || '').match(/\/restaurants\/(\d+)/);
    if (!idMatch) continue;
    var sid = parseInt(idMatch[1], 10);
    var sKey = el.getAttribute('data-key') || '';
    var sName = el.getAttribute('data-name') || '';
    var sAddr = el.getAttribute('data-addr') || '';
    var sDist = el.getAttribute('data-district') || '';
    if (!sKey) {
      // Fallback (shouldn't trigger in practice): rebuild from DOM values.
      sKey = buildKey(sName, '', sAddr, sDist, '');
    }
    INDEX.push({ id: sid, key: sKey, district: sDist, name_zh: sName, name_en: '', address: sAddr });
  }

  // 2) Read island entries (51..906). Format: [id, name_zh, name_en, district, address, extras].
  var rawIsland = [];
  try { rawIsland = JSON.parse(document.getElementById('rest-data').textContent || '{}').restaurants || []; } catch (e) { rawIsland = []; }
  // Dedupe: same id should not appear twice (static first 50 + island 51..906
  // cover 1..906 with no overlap, but be defensive).
  var seenIds = {};
  INDEX.forEach(function (e) { seenIds[e.id] = true; });
  for (var i = 0; i < rawIsland.length; i++) {
    var r = rawIsland[i];
    var id = r[0], nzh = r[1] || '', nen = r[2] || '', dist = r[3] || '', addr = r[4] || '', extras = r[5] || '';
    if (seenIds[id]) continue;
    seenIds[id] = true;
    INDEX.push({ id: id, key: buildKey(nzh, nen, addr, dist, extras), district: dist, name_zh: nzh, name_en: nen, address: addr });
  }

  // ---- Tokenizer ----
  // Split on spaces/punctuation, lowercased. Inserts a boundary at CJK↔alnum
  // transitions so e.g. "奧運Outback" → ["奧運","outback"].
  function tokenize(s) {
    if (!s) return [];
    var str = String(s).toLowerCase().replace(/\u3000/g, ' ');
    // turn common punctuation into spaces
    str = str.replace(/[、，,;；\/\\|+·．]/g, ' ');
    // Insert space at CJK↔[0-9a-z%'&.-] boundaries
    str = str.replace(/([一-鿿])([0-9a-z%'&.\-])/g, '$1 $2');
    str = str.replace(/([0-9a-z%'&.\-])([一-鿿])/g, '$1 $2');
    return str.split(/\s+/).filter(Boolean);
  }

  function matchKey(key, tokens) {
    for (var t = 0; t < tokens.length; t++) {
      var tok = tokens[t];
      if (tok.length === 0) continue;
      if (key.indexOf(tok) === -1) return false;
    }
    return true;
  }

  function matchDistrict(districtActive, entry) {
    if (!districtActive) return true;
    return entry.district === districtActive;
  }

  function runFilter(query, districtActive) {
    var tokens = tokenize(query);
    var out = [];
    for (var i = 0; i < INDEX.length; i++) {
      var e = INDEX[i];
      if (!matchDistrict(districtActive, e)) continue;
      if (tokens.length > 0 && !matchKey(e.key, tokens)) continue;
      out.push(e.id);
    }
    return out;
  }

  // ---- Render helpers ----
  function makeCardFromEntry(e) {
    var nameZh = e.name_zh || e.name_en || (e.district || '') + '狗友善餐廳';
    var sub = detectSubArea(e.address || '', e.name_zh || '');
    var subLabel = sub || e.district || '';
    var addrHtml = e.address
      ? '<span class="mx-1.5 text-gray-200">·</span><span class="text-gray-300">' + escapeHtml(e.address) + '</span>'
      : '';
    return '<a href="/restaurants/' + e.id + '"'
      + ' class="restaurant-item group bg-white rounded-xl px-4 py-3 border border-gray-100 hover:border-brand/30 hover:shadow-sm transition-all no-underline"'
      + ' data-name="' + escapeHtml((e.name_zh || e.name_en || '').toLowerCase()) + '"'
      + ' data-district="' + escapeHtml(e.district || '') + '"'
      + ' data-addr="' + escapeHtml((e.address || '').toLowerCase()) + '"'
      + ' data-key="' + escapeHtml(e.key || '') + '">'
      + '<div class="flex items-center gap-3">'
      + '<div class="w-1 h-10 bg-brand/20 rounded-full shrink-0"></div>'
      + '<div class="min-w-0 flex-1">'
      + '<h3 class="font-semibold text-sm md:text-base text-near-black group-hover:text-brand transition-colors truncate">' + escapeHtml(nameZh) + '</h3>'
      + '<p class="text-xs text-gray-500 mt-0.5 truncate">'
      + '<span class="inline-flex items-center gap-1">'
      + '<span class="text-gray-300">📍</span> '
      + '<span class="sub-area-label">' + escapeHtml(subLabel) + '</span>'
      + '</span>' + addrHtml + '</p>'
      + '</div>'
      + '<div class="text-gray-300 group-hover:text-brand transition-colors shrink-0"><span class="text-xs">→</span></div>'
      + '</div></a>';
  }

  function findIndexEntry(id) {
    for (var i = 0; i < INDEX.length; i++) {
      if (INDEX[i].id === id) return INDEX[i];
    }
    return null;
  }

  // ---- Pagination / state ----
  var state = { page: 1 };

  function currentMatches() {
    var q = document.getElementById('search-input').value || '';
    var d = document.body.getAttribute('data-active-district') || '';
    return runFilter(q, d);
  }

  function rebuildPage() {
    var list = document.getElementById('restaurant-list');
    if (!list) return;
    var ids = currentMatches();
    var total = ids.length;
    var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (state.page > totalPages) state.page = totalPages;
    if (state.page < 1) state.page = 1;
    var start = (state.page - 1) * PAGE_SIZE;
    var end = start + PAGE_SIZE;
    var visibleIds = ids.slice(start, end);
    var visibleSet = {};
    for (var vi = 0; vi < visibleIds.length; vi++) visibleSet[visibleIds[vi]] = true;

    // Hide/show static SSR cards by id.
    Array.prototype.forEach.call(list.querySelectorAll('.restaurant-item'), function (el) {
      var idMatch = (el.getAttribute('href') || '').match(/\/restaurants\/(\d+)/);
      var id = idMatch ? parseInt(idMatch[1], 10) : null;
      if (id == null) { el.style.display = 'none'; return; }
      el.style.display = visibleSet[id] ? '' : 'none';
    });

    // Strip previously-injected island cards.
    var extras = list.querySelectorAll('[data-island-card="1"]');
    for (var xi = 0; xi < extras.length; xi++) {
      var ex = extras[xi];
      if (ex.parentNode) ex.parentNode.removeChild(ex);
    }
    // Render any visible id that doesn't already have a static card on the page.
    for (var idi = 0; idi < visibleIds.length; idi++) {
      var id = visibleIds[idi];
      var staticCard = list.querySelector('#restaurant-list .restaurant-item[data-key][href$="/restaurants/' + id + '"]:not([data-island-card="1"])');
      if (staticCard && staticCard.offsetParent !== null) continue; // already visible via SSR
      var entry = findIndexEntry(id);
      if (!entry) continue;
      var tmp = document.createElement('div');
      tmp.innerHTML = makeCardFromEntry(entry);
      var node = tmp.firstChild;
      if (node) {
        node.setAttribute('data-island-card', '1');
        list.appendChild(node);
      }
    }

    var countEl = document.getElementById('result-count');
    if (countEl) countEl.textContent = total + ' 間';
    var cur = document.getElementById('pg-current');
    var tot = document.getElementById('pg-total');
    if (cur) cur.textContent = String(state.page);
    if (tot) tot.textContent = String(totalPages);
    var prev = document.getElementById('pg-prev');
    var next = document.getElementById('pg-next');
    if (prev) prev.disabled = state.page <= 1;
    if (next) next.disabled = state.page >= totalPages;

    var empty = document.getElementById('empty-state');
    if (empty) empty.classList.toggle('hidden', total > 0);
    var clear = document.getElementById('clear-filter');
    var qNow = (document.getElementById('search-input').value || '').trim();
    var dNow = document.body.getAttribute('data-active-district') || '';
    if (clear) clear.classList.toggle('hidden', !qNow && !dNow);

    var pager = document.getElementById('pager');
    if (pager) pager.style.display = total > PAGE_SIZE ? '' : 'none';
  }

  function filterList() {
    state.page = 1;
    rebuildPage();
  }

  function setDistrict(d) {
    document.querySelectorAll('[id^="pill-"]').forEach(function (el) {
      el.className = el.className.replace(/bg-brand text-white/g, 'bg-gray-50 text-gray-500');
    });
    if (d) {
      var pill = document.getElementById('pill-' + d.replace(/\s/g, ''));
      if (pill) pill.className = pill.className.replace(/bg-gray-50 text-gray-500/g, 'bg-brand text-white');
    } else {
      var pAll = document.getElementById('pill-all');
      if (pAll) pAll.className = pAll.className.replace(/bg-gray-50 text-gray-500/g, 'bg-brand text-white');
    }
    document.querySelectorAll('[data-active-district]').forEach(function (el) { el.removeAttribute('data-active-district'); });
    if (d) document.body.setAttribute('data-active-district', d);
    filterList();
  }

  function resetFilter() {
    document.getElementById('search-input').value = '';
    setDistrict('');
  }

  // ---- Pager wiring ----
  // ---- Search input: live re-filter on each keystroke ----
  document.getElementById('search-input').addEventListener('input', function () {
    filterList();
  });

  document.getElementById('pg-prev').addEventListener('click', function () {
    if (state.page > 1) { state.page--; rebuildPage(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });
  document.getElementById('pg-next').addEventListener('click', function () {
    state.page++; rebuildPage(); window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ---- Sub-area labels on initial static cards (cosmetic, no behaviour change) ----
  document.querySelectorAll('#restaurant-list .sub-area-label').forEach(function (el) {
    var addr = el.getAttribute('data-addr') || '';
    var name = el.getAttribute('data-name') || '';
    var sub = detectSubArea(addr, name);
    if (sub) el.textContent = sub;
  });

  // ---- On load: apply URL params + initial render ----
  window.addEventListener('DOMContentLoaded', function () {
    var params = new URLSearchParams(window.location.search);
    var q = params.get('q');
    var d = params.get('district');
    if (q) document.getElementById('search-input').value = q;
    if (d) setDistrict(d);
    rebuildPage();
  });
  </script>
</BaseLayout>
