---
import BaseLayout from '../layouts/BaseLayout.astro';
import restaurants from '../data/restaurants.json';
import stats from '../data/restaurant-stats.json';
import areaCentres from '../data/area-centres.json';
import areaSlugs from '../data/area-slugs.json';
import restaurantCoords from '../data/restaurant-coords.json';

const districts = [...new Set(restaurants.map((r: { district: string }) => r.district))].sort();

// Phase 2 (fix/restaurant-search-v2): unified search index across all 906 records.
// Build-time: each record gets a precomputed `search_key` = base + extras.
// Extras include SUB_AREAS detected from address+name AND any alias group
// whose `keys` (real address/name substrings) match the base.
// First 50 cards keep SSR (data-key/data-name/data-district/data-addr), island
// holds 51..906 as compact arrays so the rendered HTML stays compact while the
// client can do proper token + AND search across the whole dataset.
const PAGE_SIZE = 50;
const STATIC_COUNT = 50;

// Sub-area names (shared with client). Order matters: longer/more specific
// first so e.g. '西九龍' wins over '九龍' if both ever overlapped.
const SUB_AREAS = [
  '馬鞍山','科學園','白石角',
  '香港仔','黃竹坑','海洋公園','淺水灣','赤柱','薄扶林','數碼港','鴨脷洲',
  '中環','上環','西營盤','堅尼地城','石塘咀','半山','山頂','金鐘',
  '銅鑼灣','跑馬地','大坑','天后',
  '北角','鰂魚涌','太古','西灣河','筲箕灣','柴灣',
  '尖沙咀','尖東','佐敦','油麻地',
  '旺角','太子','大角咀',
  '長沙灣','荔枝角','美孚',
  '土瓜灣','紅磡','何文田','啟德',
  '九龍灣','觀塘','牛頭角','藍田','油塘',
  '深井','馬灣','荃灣',
  '屯門','黃金海岸',
  '元朗','天水圍','錦田',
  '上水','粉嶺',
  '大埔',
  '沙田','大圍','火炭',
  '西貢','將軍澳','坑口','寶琳','調景嶺','康城','清水灣',
  '葵涌','葵芳','青衣',
  '東涌','愉景灣','迪士尼','機場','大澳','長洲','南丫島','坪洲',
];

// Alias groups: queries in `names` should match records whose address/name
// contains any of `keys`. Both sides lowercased.
const ALIAS_GROUPS: Array<{ names: string[]; keys: string[] }> = [
  { names: ['奧運','olympic','olympian'], keys: ['奧海城','海泓道','大角咀','利奧坊','海帆道','匯翔道','櫻桃街','奧柏'] },
  { names: ['旺角東'], keys: ['旺角','太子'] },
  { names: ['西九龍','west kowloon','elements','圓方'], keys: ['西九龍','柯士甸','圓方','elements'] },
  { names: ['科學園','science park'], keys: ['科學園','白石角'] },
  { names: ['數碼港','cyberport'], keys: ['數碼港','薄扶林'] },
  { names: ['太古'], keys: ['太古','鰂魚涌'] },
  { names: ['將軍澳'], keys: ['將軍澳','坑口','寶琳','調景嶺','康城'] },
  { names: ['東涌'], keys: ['東涌','愉景灣'] },
  { names: ['馬鞍山'], keys: ['馬鞍山','烏溪沙'] },
  { names: ['機場','airport'], keys: ['機場','赤鱲角','航天城'] },
  { names: ['迪士尼','disneyland'], keys: ['迪士尼','竹篙灣'] },
  { names: ['中文大學','cuhk'], keys: ['中文大學','馬料水'] },
  { names: ['香港科技大學','hkust'], keys: ['香港科技大學','清水灣'] },
  { names: ['香港大學','hku'], keys: ['香港大學','薄扶林'] },
  { names: ['海洋公園','ocean park'], keys: ['海洋公園','黃竹坑'] },
  { names: ['黃金海岸','gold coast'], keys: ['黃金海岸','青山公路'] },
  { names: ['天水圍'], keys: ['天水圍','天慈'] },
];

function detectSubAreasFromBase(baseLower: string): string[] {
  const hits: string[] = [];
  for (const s of SUB_AREAS) {
    if (baseLower.includes(s)) hits.push(s);
  }
  return hits;
}

function detectAliasesFromBase(baseLower: string): string[] {
  const hits: string[] = [];
  for (const g of ALIAS_GROUPS) {
    if (g.keys.some(k => baseLower.includes(k))) {
      for (const n of g.names) hits.push(n);
    }
  }
  return hits;
}

function buildSearchKey(r: any): string {
  const base = [r.name_zh || '', r.name_en || '', r.address || '', r.district || '']
    .join(' ')
    .toLowerCase();
  const extras = [...detectSubAreasFromBase(base), ...detectAliasesFromBase(base)];
  // Dedupe (rare but possible overlap) and join with single spaces
  const seen = new Set<string>();
  const merged: string[] = [];
  for (const x of extras) {
    if (!seen.has(x)) { seen.add(x); merged.push(x); }
  }
  return base + ' ' + merged.join(' ');
}

// Coords lookup: prefer the building-level CSDI coords; fall back to null
// if the record has no usable lat/lng (e.g. parsed from an unusual address).
function coordsFor(id: number | string): { lat: number; lng: number; prec: string } | null {
  const c = restaurantCoords[String(id)] as { lat?: number; lng?: number; prec?: string } | undefined;
  if (!c || c.lat == null || c.lng == null) return null;
  return { lat: c.lat, lng: c.lng, prec: c.prec || 'building' };
}

type StaticCard = { id: number; name_zh: string; name_en: string; district: string; address: string; key: string; lat: number | null; lng: number | null; prec: string | null };
// Island row: [id, name_zh, name_en, district, address, extras, lat, lng, prec]
// lat/lng are null when no usable coords; prec is 'building'|'street'|'area'|null.
type IslandRow = [number, string, string, string, string, string, number | null, number | null, string | null];

const firstPage: StaticCard[] = (restaurants as any[]).slice(0, STATIC_COUNT).map((r: any) => {
  const c = coordsFor(r.id);
  return {
    id: r.id,
    name_zh: r.name_zh || r.name_en || '',
    name_en: r.name_en || r.name_zh || '',
    district: r.district || '',
    address: r.address || '',
    key: buildSearchKey(r),
    lat: c ? c.lat : null,
    lng: c ? c.lng : null,
    prec: c ? c.prec : null,
  };
});

const restData: IslandRow[] = (restaurants as any[]).slice(STATIC_COUNT).map((r: any) => {
  const base = [r.name_zh || '', r.name_en || '', r.address || '', r.district || ''].join(' ').toLowerCase();
  const extras = [...detectSubAreasFromBase(base), ...detectAliasesFromBase(base)];
  const seen = new Set<string>();
  const merged: string[] = [];
  for (const x of extras) {
    if (!seen.has(x)) { seen.add(x); merged.push(x); }
  }
  const c = coordsFor(r.id);
  return [r.id, r.name_zh || r.name_en || '', r.name_en || r.name_zh || '', r.district || '', r.address || '', merged.join(' '), c ? c.lat : null, c ? c.lng : null, c ? c.prec : null];
});
---

<BaseLayout title="🍽️ 餐廳搜尋" lang="zh">
  <div class="max-w-4xl mx-auto px-4 py-6 md:py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-3">
        <h1 class="text-xl md:text-2xl font-bold text-near-black">🍽️ 狗友善餐廳</h1>
        <span class="text-sm text-gray-500 bg-gray-50 px-2.5 py-0.5 rounded-full" id="result-count">{restaurants.length} 間</span>
      </div>
      <a href="/restaurants" class="text-xs text-gray-500 hover:text-brand no-underline hidden" id="clear-filter">清除篩選</a>
    </div>

    <!-- Search bar -->
    <div class="flex gap-2 mb-5">
      <div class="flex-1 flex gap-2">
        <input type="text" id="search-input" placeholder="搜尋餐廳、地區..."
          class="flex-1 min-w-0 px-3.5 py-2 text-sm border border-gray-100 rounded-lg outline-none focus:border-brand/50 bg-white"
        />
        <button onclick="filterList()" class="bg-brand text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700 transition-colors shrink-0">🔍</button>
      </div>
    </div>

    <!-- District pills -->
    <div class="overflow-x-auto -mx-4 px-4 mb-5 scrollbar-hide">
      <div class="flex gap-1.5 w-max md:w-auto md:flex-wrap">
        <a href="/restaurants" onclick="setDistrict(''); return false;"
          class="shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-brand text-white"
          id="pill-all">全部</a>
        {districts.map((d: string) => (
          <a href={`/restaurants?district=${encodeURIComponent(d)}`} onclick={`setDistrict('${d}'); return false;`}
            class="shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
            id={`pill-${d.replace(/\s/g, '')}`}
          >{d}</a>
        ))}
      </div>
    </div>

    <!-- Area-aware "nearest first" header. Hidden by default; client toggles
         visibility when the query matches an area-centre key. -->
    <div id="area-header" class="hidden mb-3 flex flex-col gap-2">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="inline-flex items-center gap-1.5 bg-brand/10 text-brand px-2.5 py-1 rounded-full text-xs font-medium">
          <span>📍</span><span id="area-header-label">—</span>
        </span>
        <span class="text-xs text-gray-500" id="area-header-meta">—</span>
      </div>
      <div class="flex gap-1.5 flex-wrap" id="area-radius-chips">
        <a href="#" onclick="setRadius(-1); return false;"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-brand text-white"
          data-radius="-1">全區（默認）</a>
        <a href="#" onclick="setRadius(500); return false;"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="500">500 米</a>
        <a href="#" onclick="setRadius(1000); return false;"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="1000">1 公里</a>
        <a href="#" onclick="setRadius(2000); return false;"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="2000">2 公里</a>
        <a href="#" onclick="setRadius(0); return false;"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="0">全部</a>
      </div>
      <p class="text-xs text-gray-400 mt-1 leading-relaxed" id="area-radius-legend">全區 = 區內地址命中或 1 公里內；半徑 = 嚴格只計實際距離</p>
      <a href="#" id="area-page-link" class="hidden text-xs text-brand hover:underline mt-0.5">查看此地區專頁 →</a>
    </div>

    <!-- Results list — first 50 are server-rendered for SEO; rest are JS-rendered into this same wrapper -->
    <div id="restaurant-list" class="flex flex-col gap-2">
      {firstPage.map((r: StaticCard) => (
        <a href={`/restaurants/${r.id}`}
          class="restaurant-item group bg-white rounded-xl px-4 py-3 border border-gray-100 hover:border-brand/30 hover:shadow-sm transition-all no-underline"
          data-name={(r.name_zh || r.name_en || '').toLowerCase()}
          data-district={r.district}
          data-addr={(r.address || '').toLowerCase()}
          data-key={r.key}
          data-lat={r.lat ?? ''}
          data-lng={r.lng ?? ''}
          data-prec={r.prec ?? ''}
        >
          <div class="flex items-center gap-3">
            <div class="w-1 h-10 bg-brand/20 rounded-full shrink-0"></div>
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold text-sm md:text-base text-near-black group-hover:text-brand transition-colors truncate">
                {r.name_zh || r.name_en || `${r.district}狗友善餐廳`}
              </h3>
              <p class="text-xs text-gray-500 mt-0.5 truncate">
                <span class="inline-flex items-center gap-1">
                  <span class="text-gray-300">📍</span> <span class="sub-area-label" data-addr={r.address} data-name={r.name_zh||''}>{r.district}</span>
                </span>
                <span class="mx-1.5 text-gray-200">·</span>
                <span class="text-gray-300">{r.address}</span>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="dist-badge text-xs text-gray-400 hidden whitespace-nowrap"></span>
              <span class="text-gray-300 group-hover:text-brand transition-colors">
                <span class="text-xs">→</span>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Pagination UI -->
    <nav id="pager" class="flex items-center justify-center gap-1 mt-6 text-sm select-none" aria-label="餐廳分頁">
      <button id="pg-prev" type="button" class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-500 hover:border-brand/40 disabled:opacity-30 disabled:cursor-not-allowed" disabled>← 上一頁</button>
      <span id="pg-info" class="px-2 text-gray-500"><span id="pg-current">1</span> / <span id="pg-total">19</span></span>
      <button id="pg-next" type="button" class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-500 hover:border-brand/40 disabled:opacity-30 disabled:cursor-not-allowed">下一頁 →</button>
    </nav>

    <!-- Empty state -->
    <div id="empty-state" class="text-center py-16 text-gray-500 hidden">
      <div class="text-4xl mb-3">🔍</div>
      <p class="text-sm">搵唔到相關餐廳</p>
      <a href="/restaurants" onclick="resetFilter(); return false;" class="text-brand text-sm hover:underline mt-2 inline-block">清除篩選重新搜尋</a>
    </div>
  </div>

  <!-- fix/restaurant-search-v2: data island for JS pagination. Compact array form
       [id, name_zh, name_en, district, address, extras] so the index stays small
       while making address + sub-area labels searchable from the client. -->
  <script type="application/json" id="rest-data" set:html={JSON.stringify({ restaurants: restData })} />
  <!-- Area-centre lookup table (84 entries) — read by client JS to detect
       when the query targets a place name and to compute Haversine distance. -->
  <script type="application/json" id="area-centres" set:html={JSON.stringify(areaCentres)} />
  <!-- fix/radius-chips-honest: zh-name → english-slug map for area-page links
       (only the 84 areas with a /restaurants/area/<slug> page are linked). -->
  <script type="application/json" id="area-slugs" set:html={JSON.stringify(areaSlugs)} />

  <script is:inline>
  // Sub-area names used to compute the search key (kept in sync with the SSR
  // frontmatter). Order matters: longer/more specific first.
  var SUB_AREAS = [
    '馬鞍山','科學園','白石角',
    '香港仔','黃竹坑','海洋公園','淺水灣','赤柱','薄扶林','數碼港','鴨脷洲',
    '中環','上環','西營盤','堅尼地城','石塘咀','半山','山頂','金鐘',
    '銅鑼灣','跑馬地','大坑','天后',
    '北角','鰂魚涌','太古','西灣河','筲箕灣','柴灣',
    '尖沙咀','尖東','佐敦','油麻地',
    '旺角','太子','大角咀',
    '長沙灣','荔枝角','美孚',
    '土瓜灣','紅磡','何文田','啟德',
    '九龍灣','觀塘','牛頭角','藍田','油塘',
    '深井','馬灣','荃灣',
    '屯門','黃金海岸',
    '元朗','天水圍','錦田',
    '上水','粉嶺',
    '大埔',
    '沙田','大圍','火炭',
    '西貢','將軍澳','坑口','寶琳','調景嶺','康城','清水灣',
    '葵涌','葵芳','青衣',
    '東涌','愉景灣','迪士尼','機場','大澳','長洲','南丫島','坪洲',
  ];

  function detectSubArea(addr, name) {
    var combined = (addr || '') + ' ' + (name || '');
    for (var i = 0; i < SUB_AREAS.length; i++) {
      if (combined.indexOf(SUB_AREAS[i]) !== -1) return SUB_AREAS[i];
    }
    return null;
  }

  var PAGE_SIZE = 50;

  // Helper: safe attribute setter (data-key values contain spaces + punctuation
  // so we still rely on getAttribute — escapeHtml only matters when constructing
  // HTML from user-supplied strings via innerHTML).
  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // ---- Build the unified index (906 entries, original dataset order) ----
  // Each entry: { id, key, district, name_zh, name_en, address }
  var INDEX = [];
  function buildKey(nameZh, nameEn, address, district, extras) {
    var base = [nameZh || '', nameEn || '', address || '', district || '']
      .join(' ')
      .toLowerCase();
    return base + ' ' + (extras || '');
  }

  // 1) Read static SSR cards (first 50) — prefer precomputed data-key.
  var staticEls = Array.prototype.slice.call(document.querySelectorAll('#restaurant-list .restaurant-item:not([data-island-card="1"])'));
  for (var s = 0; s < staticEls.length; s++) {
    var el = staticEls[s];
    var idMatch = (el.getAttribute('href') || '').match(/\/restaurants\/(\d+)/);
    if (!idMatch) continue;
    var sid = parseInt(idMatch[1], 10);
    var sKey = el.getAttribute('data-key') || '';
    var sName = el.getAttribute('data-name') || '';
    var sAddr = el.getAttribute('data-addr') || '';
    var sDist = el.getAttribute('data-district') || '';
    if (!sKey) {
      // Fallback (shouldn't trigger in practice): rebuild from DOM values.
      sKey = buildKey(sName, '', sAddr, sDist, '');
    }
    var sLat = el.getAttribute('data-lat');
    var sLng = el.getAttribute('data-lng');
    var sPrec = el.getAttribute('data-prec');
    INDEX.push({
      id: sid,
      key: sKey,
      district: sDist,
      name_zh: sName,
      name_en: '',
      address: sAddr,
      lat: sLat === '' || sLat == null ? null : Number(sLat),
      lng: sLng === '' || sLng == null ? null : Number(sLng),
      prec: sPrec === '' || sPrec == null ? null : sPrec,
    });
  }

  // 2) Read island entries (51..906). Format: [id, name_zh, name_en, district, address, extras, lat, lng, prec].
  var rawIsland = [];
  try { rawIsland = JSON.parse(document.getElementById('rest-data').textContent || '{}').restaurants || []; } catch (e) { rawIsland = []; }
  // Dedupe: same id should not appear twice (static first 50 + island 51..906
  // cover 1..906 with no overlap, but be defensive).
  var seenIds = {};
  INDEX.forEach(function (e) { seenIds[e.id] = true; });
  for (var i = 0; i < rawIsland.length; i++) {
    var r = rawIsland[i];
    var id = r[0], nzh = r[1] || '', nen = r[2] || '', dist = r[3] || '', addr = r[4] || '', extras = r[5] || '';
    if (seenIds[id]) continue;
    seenIds[id] = true;
    INDEX.push({
      id: id,
      key: buildKey(nzh, nen, addr, dist, extras),
      district: dist,
      name_zh: nzh,
      name_en: nen,
      address: addr,
      lat: r[6] == null ? null : Number(r[6]),
      lng: r[7] == null ? null : Number(r[7]),
      prec: r[8] || null,
    });
  }

  // 3) Area-centre table (84 places). Read once on script init.
  var AREA_CENTRES = {};
  try { AREA_CENTRES = JSON.parse(document.getElementById('area-centres').textContent || '{}') || {}; } catch (e) { AREA_CENTRES = {}; }
  // Sort keys by length DESC so longest match wins (e.g. '西九龍' before '九龍').
  var AREA_KEYS_SORTED = Object.keys(AREA_CENTRES).sort(function (a, b) { return b.length - a.length; });
  // fix/radius-chips-honest: zh-name → english-slug map. Used to build the
  // "查看此地區專頁 →" link in the area header (only valid for the 84 areas
  // that have a /restaurants/area/<slug> page).
  var AREA_SLUGS = {};
  try { AREA_SLUGS = JSON.parse(document.getElementById('area-slugs').textContent || '{}') || {}; } catch (e) { AREA_SLUGS = {}; }

  // ---- Tokenizer ----
  // Split on spaces/punctuation, lowercased. Inserts a boundary at CJK↔alnum
  // transitions so e.g. "奧運Outback" → ["奧運","outback"].
  function tokenize(s) {
    if (!s) return [];
    var str = String(s).toLowerCase().replace(/\u3000/g, ' ');
    // turn common punctuation into spaces
    str = str.replace(/[、，,;；\/\\|+·．]/g, ' ');
    // Insert space at CJK↔[0-9a-z%'&.-] boundaries
    str = str.replace(/([一-鿿])([0-9a-z%'&.\-])/g, '$1 $2');
    str = str.replace(/([0-9a-z%'&.\-])([一-鿿])/g, '$1 $2');
    return str.split(/\s+/).filter(Boolean);
  }

  function matchKey(key, tokens) {
    for (var t = 0; t < tokens.length; t++) {
      var tok = tokens[t];
      if (tok.length === 0) continue;
      if (key.indexOf(tok) === -1) return false;
    }
    return true;
  }

  function matchDistrict(districtActive, entry) {
    if (!districtActive) return true;
    return entry.district === districtActive;
  }

  // New algorithm (area-nearby-search v2):
  //   1. tokenize(query) and detect activeArea (longest area-centre key found in
  //      the lowercased query).
  //   2. No activeArea → legacy token-AND filter, dataset order, no chips.
  //   3. activeArea + filterTokens empty (pure area query):
  //        results = token-matched ∪ records within current radius of centre;
  //        bucketed sort: precise (prec≠'area') cards first by raw dist;
  //        area-prec cards last by raw dist; null-dist last. radius chips visible.
  //   4. activeArea + filterTokens non-empty (e.g. "奧運 Outback"):
  //        results = INDEX records whose key contains ALL filterTokens (no radius
  //        union); same bucketed sort; radius chips hidden.
  function runFilter(query, districtActive) {
    var tokens = tokenize(query);
    // Detect activeArea: longest area-centre key fully contained in query.
    var activeArea = null;
    if (query && query.trim()) {
      var qLower = query.toLowerCase().trim();
      for (var ai = 0; ai < AREA_KEYS_SORTED.length; ai++) {
        var k = AREA_KEYS_SORTED[ai];
        if (k && qLower.indexOf(k) !== -1) { activeArea = k; break; }
      }
    }
    if (!activeArea) {
      // Non-area mode — legacy behaviour: token-AND filter, dataset order.
      var out0 = [];
      for (var i = 0; i < INDEX.length; i++) {
        var e0 = INDEX[i];
        if (!matchDistrict(districtActive, e0)) continue;
        if (tokens.length > 0 && !matchKey(e0.key, tokens)) continue;
        out0.push(e0.id);
      }
      return { ids: out0, areaMode: false, areaName: null, showChips: false, dist: {} };
    }
    // Area-mode. Split query into activeArea + filterTokens (rest after removing
    // the area-key substring once).
    var qLower2 = query.toLowerCase().trim();
    var rest = qLower2.replace(activeArea.toLowerCase(), ' ', 1);
    var filterTokens = tokenize(rest);
    var centre = AREA_CENTRES[activeArea];
    var clat = centre.lat, clng = centre.lng;
    var radius = (state.radius == null) ? 1000 : state.radius;
    var byId = {};
    var distById = {};
    function distOfEntry(em) {
      return (em.lat != null && em.lng != null) ? haversine(clat, clng, em.lat, em.lng) : null;
    }
    if (filterTokens.length > 0) {
      // Pure keyword filter (no radius expansion). Still compute distance for
      // sorting + display, and skip records with no district match.
      for (var fi = 0; fi < INDEX.length; fi++) {
        var ef = INDEX[fi];
        if (!matchDistrict(districtActive, ef)) continue;
        if (!matchKey(ef.key, filterTokens)) continue;
        byId[ef.id] = true;
        distById[ef.id] = distOfEntry(ef);
      }
    } else {
      // Pure area query (e.g. "尖沙咀"). fix/radius-chips-honest: the "全區"
      // chip (radius === -1) preserves the legacy union behaviour — every
      // token-matched record ∪ every record within 1 km of the area centre,
      // i.e. the previous default semantics and counts. The 500 m / 1 km /
      // 2 km chips are STRICT: address hits outside the radius are dropped.
      // radius === 0 (全部) keeps every record as before.
      var radiusChip = radius;
      if (radiusChip === -1) {
        // 全區 — name hits ∪ within 1 km (current default behaviour).
        for (var mi = 0; mi < INDEX.length; mi++) {
          var em = INDEX[mi];
          if (!matchDistrict(districtActive, em)) continue;
          if (tokens.length > 0 && !matchKey(em.key, tokens)) continue;
          byId[em.id] = true;
          distById[em.id] = distOfEntry(em);
        }
        var unionRadius = 1000;
        for (var ki = 0; ki < INDEX.length; ki++) {
          var e2 = INDEX[ki];
          if (byId[e2.id]) continue;
          if (!matchDistrict(districtActive, e2)) continue;
          if (e2.lat == null || e2.lng == null) continue;
          var d2 = haversine(clat, clng, e2.lat, e2.lng);
          if (d2 <= unionRadius) {
            byId[e2.id] = true;
            distById[e2.id] = d2;
          }
        }
      } else if (radiusChip === 0) {
        // "全部" radius: include every record (even no-coord).
        for (var ni = 0; ni < INDEX.length; ni++) {
          var en = INDEX[ni];
          if (!matchDistrict(districtActive, en)) continue;
          byId[en.id] = true;
          distById[en.id] = null;
        }
      } else {
        // Strict radius chip (500 / 1000 / 2000): only records whose real
        // Haversine distance to the area centre is ≤ radius. Name hits beyond
        // the radius are excluded — that's the whole point of the chip.
        for (var si = 0; si < INDEX.length; si++) {
          var es = INDEX[si];
          if (!matchDistrict(districtActive, es)) continue;
          if (es.lat == null || es.lng == null) continue;
          var ds = haversine(clat, clng, es.lat, es.lng);
          if (ds <= radiusChip) {
            byId[es.id] = true;
            distById[es.id] = ds;
          }
        }
      }
    }
    // Sort: precise records first (asc by dist); then area-prec records last
    // (also asc by dist). Null dist last overall. No fake-distance penalty —
    // area-prec records visually group into the '位置約略' bucket and we want
    // them physically separated from precise records with real numbers.
    var entries = [];
    for (var id in byId) {
      var ent = null;
      for (var lj = 0; lj < INDEX.length; lj++) { if (INDEX[lj].id === Number(id)) { ent = INDEX[lj]; break; } }
      entries.push({ id: Number(id), dist: distById[id], prec: ent ? ent.prec : null });
    }
    entries.sort(function (a, b) {
      var aArea = a.prec === 'area' ? 1 : 0;
      var bArea = b.prec === 'area' ? 1 : 0;
      if (aArea !== bArea) return aArea - bArea;
      if (a.dist == null && b.dist == null) return 0;
      if (a.dist == null) return 1;
      if (b.dist == null) return -1;
      return a.dist - b.dist;
    });
    var ids = [];
    for (var si = 0; si < entries.length; si++) ids.push(entries[si].id);
    return {
      ids: ids,
      areaMode: true,
      areaName: activeArea,
      showChips: filterTokens.length === 0,
      dist: distById,
    };
  }

  // Haversine in metres. Pure JS — no Math.asin2.
  function haversine(lat1, lng1, lat2, lng2) {
    var R = 6371000.0;
    var toRad = function (x) { return x * Math.PI / 180; };
    var dLat = toRad(lat2 - lat1);
    var dLng = toRad(lng2 - lng1);
    var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
            Math.sin(dLng / 2) * Math.sin(dLng / 2);
    var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  // Format metres → "320 米" or "1.2 公里". Returns null when distance is null.
  function formatDistanceZh(d) {
    if (d == null) return null;
    if (d < 1000) return Math.round(d) + ' 米';
    return (d / 1000).toFixed(1) + ' 公里';
  }
  // Walking minutes from metres (80 m/min). Round to nearest integer, minimum 1,
  // and only show when ≤ 1200m to avoid noisy 30-min labels.
  function walkingMinutes(d) {
    if (d == null || d > 1200) return null;
    return Math.max(1, Math.round(d / 80));
  }

  // ---- Render helpers ----
  function makeCardFromEntry(e, dist) {
    var nameZh = e.name_zh || e.name_en || (e.district || '') + '狗友善餐廳';
    var sub = detectSubArea(e.address || '', e.name_zh || '');
    var subLabel = sub || e.district || '';
    var addrHtml = e.address
      ? '<span class="mx-1.5 text-gray-200">·</span><span class="text-gray-300">' + escapeHtml(e.address) + '</span>'
      : '';
    var distHtml = '';
    if (dist != null) {
      var entry = findIndexEntry(e.id);
      // Area-prec records only carry the area-centre coordinate, not a real
      // door address — showing "~0 米" or "920 米" would lie about the actual
      // distance. Surface the limitation honestly: badge says "位置約略" only.
      if (entry && entry.prec === 'area') {
        distHtml = '<span class="dist-badge text-xs text-gray-400 whitespace-nowrap">位置約略</span>';
      } else {
        var dStr = formatDistanceZh(dist);
        var mins = walkingMinutes(dist);
        var walk = mins != null ? ' · 步行 ' + mins + ' 分鐘' : '';
        distHtml = '<span class="dist-badge text-xs text-gray-400 whitespace-nowrap">' + escapeHtml(dStr + walk) + '</span>';
      }
    } else {
      distHtml = '<span class="dist-badge text-xs text-gray-400 hidden whitespace-nowrap"></span>';
    }
    return '<a href="/restaurants/' + e.id + '"'
      + ' class="restaurant-item group bg-white rounded-xl px-4 py-3 border border-gray-100 hover:border-brand/30 hover:shadow-sm transition-all no-underline"'
      + ' data-name="' + escapeHtml((e.name_zh || e.name_en || '').toLowerCase()) + '"'
      + ' data-district="' + escapeHtml(e.district || '') + '"'
      + ' data-addr="' + escapeHtml((e.address || '').toLowerCase()) + '"'
      + ' data-key="' + escapeHtml(e.key || '') + '">'
      + '<div class="flex items-center gap-3">'
      + '<div class="w-1 h-10 bg-brand/20 rounded-full shrink-0"></div>'
      + '<div class="min-w-0 flex-1">'
      + '<h3 class="font-semibold text-sm md:text-base text-near-black group-hover:text-brand transition-colors truncate">' + escapeHtml(nameZh) + '</h3>'
      + '<p class="text-xs text-gray-500 mt-0.5 truncate">'
      + '<span class="inline-flex items-center gap-1">'
      + '<span class="text-gray-300">📍</span> '
      + '<span class="sub-area-label">' + escapeHtml(subLabel) + '</span>'
      + '</span>' + addrHtml + '</p>'
      + '</div>'
      + '<div class="flex items-center gap-2 shrink-0">'
      + distHtml
      + '<span class="text-gray-300 group-hover:text-brand transition-colors"><span class="text-xs">→</span></span>'
      + '</div>'
      + '</div></a>';
  }

  // Group-header labels (zh). Bucket key 0/1/2/3/4.
  var GROUP_LABELS_ZH = [
    '步行 5 分鐘內（400 米內）',
    '步行 15 分鐘內（1.2 公里內）',
    '車程範圍（3 公里內）',
    '較遠',
    '位置約略',
  ];
  function bucketFor(d, isAreaPrec) {
    // 0..3: distance buckets for precise (building/street) records.
    // 4: '位置約略' — any record with area-prec (no real door address).
    // -1: no coords at all (very rare); such rows carry no group header on
    // purpose — they are sparse outliers, not a meaningful user-facing bucket.
    if (isAreaPrec) return 4;
    if (d == null) return -1;
    if (d <= 400) return 0;
    if (d <= 1200) return 1;
    if (d <= 3000) return 2;
    return 3;
  }

  function findIndexEntry(id) {
    for (var i = 0; i < INDEX.length; i++) {
      if (INDEX[i].id === id) return INDEX[i];
    }
    return null;
  }

  // ---- Pagination / state ----
  // fix/radius-chips-honest: state.radius === -1 means "全區" (legacy union
  // semantics). 500/1000/2000 are STRICT distance filters. 0 = 全部 (every
  // record, unchanged).
  var state = { page: 1, radius: -1 };

  function currentMatches() {
    var q = document.getElementById('search-input').value || '';
    var d = document.body.getAttribute('data-active-district') || '';
    return runFilter(q, d);
  }

  function renderAreaHeader(areaName, total, showChips) {
    var header = document.getElementById('area-header');
    var labelEl = document.getElementById('area-header-label');
    var metaEl = document.getElementById('area-header-meta');
    var chipsEl = document.getElementById('area-radius-chips');
    var legendEl = document.getElementById('area-radius-legend');
    var linkEl = document.getElementById('area-page-link');
    if (!header) return;
    if (!areaName) { header.classList.add('hidden'); return; }
    header.classList.remove('hidden');
    // Header format: "<areaName> · <count> 間（最近優先）"
    labelEl.textContent = areaName;
    metaEl.textContent = total + ' 間（最近優先）';
    // Show radius chips + legend only when filterTokens are empty (pure area query).
    if (chipsEl) chipsEl.style.display = showChips ? '' : 'none';
    if (legendEl) legendEl.style.display = showChips ? '' : 'none';
    // Area-page link: pure area query only. href = /restaurants/area/<slug>
    // looked up from the area-slugs island (zh-name → english-slug map).
    if (linkEl) {
      if (showChips && AREA_SLUGS && AREA_SLUGS[areaName]) {
        linkEl.href = '/restaurants/area/' + AREA_SLUGS[areaName];
        linkEl.classList.remove('hidden');
      } else {
        linkEl.classList.add('hidden');
      }
    }
    // Highlight active chip
    var chips = header.querySelectorAll('.radius-chip');
    for (var i = 0; i < chips.length; i++) {
      var c = chips[i];
      var r = Number(c.getAttribute('data-radius'));
      if (r === state.radius) {
        c.className = c.className.replace(/bg-gray-50 text-gray-500 hover:bg-gray-100/g, 'bg-brand text-white');
      } else {
        c.className = c.className.replace(/bg-brand text-white/g, 'bg-gray-50 text-gray-500 hover:bg-gray-100');
      }
    }
  }

  function radiusLabel(r) {
    if (r === -1) return '全區';
    if (!r || r === 0) return '全部';
    if (r === 500) return '500 米';
    if (r === 1000) return '1 公里';
    if (r === 2000) return '2 公里';
    return (r < 1000 ? r + ' 米' : (r / 1000).toFixed(1) + ' 公里');
  }

  // Group-header chip element (used when area-mode + we want bucketed sections).
  function groupHeaderEl(label) {
    var div = document.createElement('div');
    div.className = 'area-group-header bg-gray-50 text-xs text-gray-500 px-3 py-1.5 rounded-full self-start mt-2 mb-0';
    div.textContent = label;
    div.setAttribute('data-area-group', '1');
    return div;
  }

  function rebuildPage() {
    var list = document.getElementById('restaurant-list');
    if (!list) return;
    var res = currentMatches();
    var ids = res.ids;
    var distMap = res.dist || {};
    var total = ids.length;
    var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (state.page > totalPages) state.page = totalPages;
    if (state.page < 1) state.page = 1;
    var start = (state.page - 1) * PAGE_SIZE;
    var end = start + PAGE_SIZE;
    var visibleIds = ids.slice(start, end);
    var visibleSet = {};
    for (var vi = 0; vi < visibleIds.length; vi++) visibleSet[visibleIds[vi]] = true;

    // Update distance badges on static SSR cards.
    Array.prototype.forEach.call(list.querySelectorAll('.restaurant-item:not([data-island-card="1"])'), function (el) {
      var idMatch = (el.getAttribute('href') || '').match(/\/restaurants\/(\d+)/);
      var id = idMatch ? parseInt(idMatch[1], 10) : null;
      var badge = el.querySelector('.dist-badge');
      var d = id != null ? distMap[id] : null;
      if (badge) {
        if (d != null) {
          var entry = findIndexEntry(id);
          // area-prec → show "位置約略" instead of a (fake) numeric distance.
          if (entry && entry.prec === 'area') {
            badge.textContent = '位置約略';
            badge.classList.remove('hidden');
          } else {
            var dStr = formatDistanceZh(d);
            var mins = walkingMinutes(d);
            var walk = mins != null ? ' · 步行 ' + mins + ' 分鐘' : '';
            badge.textContent = dStr + walk;
            badge.classList.remove('hidden');
          }
        } else {
          badge.textContent = '';
          badge.classList.add('hidden');
        }
      }
    });

    // Hide/show static SSR cards by id.
    Array.prototype.forEach.call(list.querySelectorAll('.restaurant-item'), function (el) {
      var idMatch = (el.getAttribute('href') || '').match(/\/restaurants\/(\d+)/);
      var id = idMatch ? parseInt(idMatch[1], 10) : null;
      if (id == null) { el.style.display = 'none'; return; }
      el.style.display = visibleSet[id] ? '' : 'none';
    });

    // Strip previously-injected island cards AND area group headers.
    var extras = list.querySelectorAll('[data-island-card="1"]');
    for (var xi = 0; xi < extras.length; xi++) {
      var ex = extras[xi];
      if (ex.parentNode) ex.parentNode.removeChild(ex);
    }
    var groups = list.querySelectorAll('[data-area-group="1"]');
    for (var gi = 0; gi < groups.length; gi++) {
      var g = groups[gi];
      if (g.parentNode) g.parentNode.removeChild(g);
    }

    // In area-mode the sorted order can disagree with the SSR DOM order (which
    // is by id), so we hide ALL static SSR cards and render everything from the
    // island. The result list then reflects the sorted `visibleIds` exactly.
    // For non-area-mode we keep the SSR optimisation (hide/show by id).
    if (res.areaMode) {
      Array.prototype.forEach.call(list.querySelectorAll('.restaurant-item:not([data-island-card="1"])'), function (el) {
        el.style.display = 'none';
      });
    }

    // Render visible ids (in the sorted order from runFilter).
    var lastBucket = -2;
    for (var idi = 0; idi < visibleIds.length; idi++) {
      var id = visibleIds[idi];
      // Insert group header when bucket changes (only in area-mode).
      if (res.areaMode) {
        var entry2 = findIndexEntry(id);
        var d = distMap[id] != null ? distMap[id] : null;
        var prec = entry2 ? entry2.prec : null;
        var b = bucketFor(d, prec === 'area');
        if (b !== lastBucket) {
          if (b >= 0 && b < GROUP_LABELS_ZH.length) {
            list.appendChild(groupHeaderEl(GROUP_LABELS_ZH[b]));
          }
          lastBucket = b;
        }
      }
      var staticCard = res.areaMode ? null : list.querySelector('#restaurant-list .restaurant-item[data-key][href$="/restaurants/' + id + '"]:not([data-island-card="1"])');
      if (staticCard && staticCard.offsetParent !== null) continue; // already visible via SSR
      var entry = findIndexEntry(id);
      if (!entry) continue;
      var tmp = document.createElement('div');
      tmp.innerHTML = makeCardFromEntry(entry, distMap[id] != null ? distMap[id] : null);
      var node = tmp.firstChild;
      if (node) {
        node.setAttribute('data-island-card', '1');
        list.appendChild(node);
      }
    }

    var countEl = document.getElementById('result-count');
    if (countEl) countEl.textContent = total + ' 間';
    var cur = document.getElementById('pg-current');
    var tot = document.getElementById('pg-total');
    if (cur) cur.textContent = String(state.page);
    if (tot) tot.textContent = String(totalPages);
    var prev = document.getElementById('pg-prev');
    var next = document.getElementById('pg-next');
    if (prev) prev.disabled = state.page <= 1;
    if (next) next.disabled = state.page >= totalPages;

    var empty = document.getElementById('empty-state');
    if (empty) empty.classList.toggle('hidden', total > 0);
    var clear = document.getElementById('clear-filter');
    var qNow = (document.getElementById('search-input').value || '').trim();
    var dNow = document.body.getAttribute('data-active-district') || '';
    if (clear) clear.classList.toggle('hidden', !qNow && !dNow);

    var pager = document.getElementById('pager');
    if (pager) pager.style.display = total > PAGE_SIZE ? '' : 'none';

    // Area-mode header (toggle visibility + label).
    renderAreaHeader(res.areaMode ? res.areaName : null, total, !!res.showChips);
  }

  function filterList() {
    state.page = 1;
    rebuildPage();
  }

  function setDistrict(d) {
    document.querySelectorAll('[id^="pill-"]').forEach(function (el) {
      el.className = el.className.replace(/bg-brand text-white/g, 'bg-gray-50 text-gray-500');
    });
    if (d) {
      var pill = document.getElementById('pill-' + d.replace(/\s/g, ''));
      if (pill) pill.className = pill.className.replace(/bg-gray-50 text-gray-500/g, 'bg-brand text-white');
    } else {
      var pAll = document.getElementById('pill-all');
      if (pAll) pAll.className = pAll.className.replace(/bg-gray-50 text-gray-500/g, 'bg-brand text-white');
    }
    document.querySelectorAll('[data-active-district]').forEach(function (el) { el.removeAttribute('data-active-district'); });
    if (d) document.body.setAttribute('data-active-district', d);
    filterList();
  }

  function resetFilter() {
    document.getElementById('search-input').value = '';
    // fix/radius-chips-honest: default radius chip is "全區" (-1).
    state.radius = -1;
    setDistrict('');
  }

  function setRadius(r) {
    state.radius = r;
    state.page = 1;
    rebuildPage();
  }

  // ---- Pager wiring ----
  // ---- Search input: live re-filter on each keystroke ----
  document.getElementById('search-input').addEventListener('input', function () {
    filterList();
  });

  document.getElementById('pg-prev').addEventListener('click', function () {
    if (state.page > 1) { state.page--; rebuildPage(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });
  document.getElementById('pg-next').addEventListener('click', function () {
    state.page++; rebuildPage(); window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ---- Sub-area labels on initial static cards (cosmetic, no behaviour change) ----
  document.querySelectorAll('#restaurant-list .sub-area-label').forEach(function (el) {
    var addr = el.getAttribute('data-addr') || '';
    var name = el.getAttribute('data-name') || '';
    var sub = detectSubArea(addr, name);
    if (sub) el.textContent = sub;
  });

  // ---- On load: apply URL params + initial render ----
  window.addEventListener('DOMContentLoaded', function () {
    var params = new URLSearchParams(window.location.search);
    var q = params.get('q');
    var d = params.get('district');
    if (q) document.getElementById('search-input').value = q;
    if (d) setDistrict(d);
    rebuildPage();
  });
  </script>
</BaseLayout>
