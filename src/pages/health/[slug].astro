---
import BaseLayout from '../../layouts/BaseLayout.astro';
import articles from '../../data/health-articles.json';

export function getStaticPaths() {
  return articles.map((a: any) => ({
    params: { slug: a.slug },
    props: { article: a },
  }));
}

const { article } = Astro.props;
---

<BaseLayout title={article.title} lang="zh">
  <div class="max-w-3xl mx-auto px-4 py-6 md:py-8">
    <a href="/health" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-brand no-underline mb-4">
      ← 健康圖書館
    </a>

    <div class="mb-6">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-[10px] bg-brand-light text-brand/80 px-2 py-0.5 rounded-full font-medium">{article.catName}</span>
        <span class="text-[10px] text-gray-300">{article.tags}</span>
      </div>
      <h1 class="text-xl md:text-2xl font-bold text-near-black leading-tight">{article.emoji} {article.title}</h1>
      {article.source && <p class="text-xs text-gray-400 mt-2">{article.source}</p>}
    </div>

    <div class="bg-white rounded-xl border border-gray-100 p-4 md:p-6">
      <div class="prose-custom">
        {article.content_html}
      </div>
    </div>

    {article.disclaimer && (
      <div class="mt-6 bg-amber-50 border border-amber-100 rounded-xl p-4">
        <p class="text-xs text-amber-700 leading-relaxed">{article.disclaimer}</p>
      </div>
    )}
  </div>
</BaseLayout>
