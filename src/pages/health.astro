---
import BaseLayout from '../layouts/BaseLayout.astro';
import articles from '../data/health-articles.json';

// Derive short `desc` from the first paragraph of content_html when not stored.
// content_html in health-articles.json is double-encoded (literal HTML
// entities), so decode first then strip tags.
// v2 (2026-09-19)：原本抽到嘅第一段有兩種垃圾 —— ① markdown 標題殘留（"# 標題 — 副題"，
// 同卡片標題重複）② LLM 前言（"好的，沒問題。作為一位專業的寵物健康內容作家…"）。
// 呢啲會令列表睇落好亂 → 逐段篩，揀第一段「真內容」。
const JUNK_PREFIX = /^(好的|好的，|沒問題|作為一位|作為一個|以下是|以下係|這是一篇|這是一份|我已經|我已|希望|以上|根據您|根據你|明白)/;

function cleanText(raw: string): string {
  return raw
    .replace(/<[^>]+>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&[a-z]+;/gi, ' ')
    .replace(/^[\s#*>\-–—]+/, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function deriveDesc(html: string, title = '', maxLen = 78): string {
  const decoded = html
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&amp;/g, '&')
    .replace(/&nbsp;/g, ' ');
  const paras = Array.from(decoded.matchAll(/<p[^>]*>([\s\S]*?)<\/p>/g)).map((m) => m[1]);
  const titleKey = (title || '').replace(/\s+/g, '').slice(0, 8);
  for (const raw of paras) {
    const text = cleanText(raw);
    if (text.length < 15) continue;                       // 太短／空段
    if (/^[*#\-–—\s]*$/.test(text)) continue;             // 純符號
    if (JUNK_PREFIX.test(text)) continue;                 // LLM 前言
    if (titleKey && text.replace(/\s+/g, '').startsWith(titleKey)) continue; // 同標題重複
    return text.length > maxLen ? text.slice(0, maxLen).trimEnd() + '…' : text;
  }
  return '';
}

const enriched = (articles as any[]).map((a) => ({
  ...a,
  desc: a.desc ?? deriveDesc(a.content_html || '', a.title || ''),
}));

const catFilter = Astro.url.searchParams.get('cat') || '';
const filtered = catFilter ? enriched.filter(a => a.cat === catFilter) : enriched;

const categories = [
  { id: '', name: '全部', count: enriched.length },
  { id: 'nutrition', name: '營養', count: enriched.filter(a => a.cat === 'nutrition').length },
  { id: 'tcm', name: '中醫', count: enriched.filter(a => a.cat === 'tcm').length },
  { id: 'care', name: '護理', count: enriched.filter(a => a.cat === 'care').length },
  { id: 'behavior', name: '行為', count: enriched.filter(a => a.cat === 'behavior').length },
];
---

<BaseLayout title="📚 健康圖書館" lang="zh">
  <div class="max-w-4xl mx-auto px-4 py-6 md:py-8">
    <h1 class="text-xl md:text-2xl font-bold text-near-black mb-1">📚 健康指南</h1>
    <p class="text-sm text-gray-500 mb-5">由專業寵物課程改編，經重新編寫加入原創內容與最新研究</p>

    <div class="flex gap-2 mb-5 flex-wrap">
      <a href="/meals/" class="btn btn-primary no-underline">
        🥘 鮮食餐單庫
      </a>
      <a href="/meals/recommend/" class="btn btn-ghost no-underline">
        ✨ 即時餐單推薦
      </a>
    </div>

    <!-- Category pills -->
    <div class="overflow-x-auto -mx-4 px-4 mb-5 scrollbar-hide">
      <div class="flex gap-1.5 w-max md:w-auto">
        {categories.map((c: { id: string; name: string; count: number }) => (
          <a href={c.id ? `/health?cat=${c.id}` : '/health'}
            class:list={['chip no-underline shrink-0', { 'is-active': catFilter === c.id }]}
          >{c.name} ({c.count})</a>
        ))}
      </div>
    </div>

    <!-- Article grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {filtered.map((a: { emoji: string; title: string; desc: string; cat: string; catName: string; date: string; slug: string }) => (
        <a href={`/health/${a.slug}`}
          class="article-card group no-underline"
        >
          <div class="flex items-center gap-3.5">
            <span class="monogram shrink-0" style="font-size:26px" aria-hidden="true">{a.emoji}</span>
            <h2 class="min-w-0 flex-1 group-hover:text-brand transition-colors">
              {a.title}
            </h2>
            <span class="lc-arrow shrink-0" aria-hidden="true">→</span>
          </div>
          {a.desc && <p class="ac-desc">{a.desc}</p>}
          <div class="flex items-center gap-2 mt-2.5">
            <span class="badge">{a.catName}</span>
            <span class="text-base text-gray-500 font-num">{a.date}</span>
          </div>
        </a>
      ))}
    </div>

    {filtered.length === 0 && (
      <div class="text-center py-16 text-gray-500">
        <p class="text-sm">該分類暫時未有文章</p>
        <a href="/health" class="text-brand text-sm hover:underline mt-2 inline-block">睇全部文章</a>
      </div>
    )}
  </div>
</BaseLayout>
