---
import BaseLayout from '../layouts/BaseLayout.astro';
import restaurants from '../data/restaurants.json';
import stats from '../data/restaurant-stats.json';
import coords from '../data/restaurant-coords.json';

// Build marker data
const markers = restaurants
  .filter((r: { id: number }) => coords[r.id])
  .map((r: { id: number; name_zh: string; name_en: string; district: string; address: string }) => ({
    id: r.id,
    name: r.name_zh || r.name_en || `${r.district}狗友善餐廳`,
    district: r.district,
    address: r.address,
    lat: coords[r.id].lat,
    lng: coords[r.id].lng,
  }));
---

<BaseLayout title="🗺️ 狗友善餐廳地圖" lang="zh">
  <div class="max-w-6xl mx-auto px-4 py-4 md:py-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-3">
      <div>
        <h1 class="text-lg md:text-xl font-bold text-near-black">🗺️ 餐廳地圖</h1>
        <p class="text-xs text-gray-500 mt-0.5">{stats.total} 間狗友善餐廳</p>
      </div>
      <div class="flex items-center gap-2 text-xs text-gray-500">
        <span class="w-2.5 h-2.5 rounded-full bg-brand shrink-0"></span>
        <span>一間</span>
        {Object.entries(coords).length > 0 && (
          <span class="ml-2 px-2 py-0.5 bg-brand-light text-brand/80 rounded-full">{Object.keys(coords).length} 個標記</span>
        )}
      </div>
    </div>

    <!-- Full-screen map -->
    <div id="all-restaurants-map" class="w-full h-[65vh] md:h-[75vh] rounded-xl border border-gray-100 z-0"
      data-markers={JSON.stringify(markers)}
    ></div>

    <!-- Legend -->
    <div class="flex flex-wrap items-center gap-3 mt-3 text-xs text-gray-500">
      <span>🖱️ 拖動地圖・滾輪放大縮細</span>
      <span>·</span>
      <span>📍 Click 標記查看餐廳</span>
    </div>
  </div>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
  <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>
  <script src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.1.0/leaflet-maplibre-gl.js" is:inline></script>
  <script src="/basemap.js" is:inline></script>
  <script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var el = document.getElementById('all-restaurants-map');
    if (!el || typeof L === 'undefined') return;

    var markers;
    try {
      markers = JSON.parse(el.getAttribute('data-markers') || '[]');
    } catch(e) {
      el.innerHTML = '<div class="flex items-center justify-center h-full text-sm text-gray-500">地圖資料載入失敗</div>';
      return;
    }

    if (!markers || markers.length === 0) {
      el.innerHTML = '<div class="flex items-center justify-center h-full text-sm text-gray-500">暫無餐廳位置資料</div>';
      return;
    }

    // Calculate bounds from all markers
    var bounds = L.latLngBounds();
    markers.forEach(function(m) {
      bounds.extend([m.lat, m.lng]);
    });

    var map = L.map(el, {
      zoomControl: true,
      scrollWheelZoom: true
    }).fitBounds(bounds, { padding: [30, 30] });

    // Basemap: OpenFreeMap positron vector (keyless) with Esri Light Gray raster fallback
    NexiBasemap.add(map);

    // Color per district — v3「繪本牛奶盒」暖色系（唔再用紫）
    var districtColors = {
      '中西區': '#8C2318', '灣仔區': '#D9432B', '東區': '#E9822B',
      '南區': '#C9A227', '油尖區': '#F6D77A', '深水埗區': '#8A9B4A',
      '九龍城區': '#4E7A3A', '黃大仙區': '#2F6F6B', '觀塘區': '#3D6B9A',
      '荃灣區': '#5B5EA6', '屯門區': '#7A5AA6', '元朗區': '#A64C86',
      '北區': '#B5467A', '大埔區': '#8C6D4F', '沙田區': '#6E8C7A',
      '西貢區': '#2F5D8C', '葵青區': '#A34B2A', '離島區': '#1E6E6A',
      '旺角區': '#E0A0B0',
    };

    markers.forEach(function(m) {
      var color = districtColors[m.district] || '#C03818';
      var icon = L.divIcon({
        className: 'custom-marker',
        html: '<div style="width:24px;height:24px;display:flex;align-items:center;justify-content:center"><span style="width:14px;height:14px;background:' + color + ';border:2px solid #1B1814;border-radius:50%;box-shadow:0 1px 2px rgba(27,24,20,0.35);display:block"></span></div>',
        iconSize: [24, 24],
        iconAnchor: [12, 12],
        popupAnchor: [0, -8]
      });

      L.marker([m.lat, m.lng], { icon: icon }).addTo(map)
        .bindPopup(
          '<div style="font-size:15px;line-height:1.5;min-width:180px">' +
          '<strong>' + m.name + '</strong><br>' +
          '<span style="color:#4A433A;font-size:14.5px">📍 ' + m.district + '</span><br>' +
          '<span style="color:#5C544A;font-size:14px">' + (m.address || '') + '</span><br>' +
          '<a href="/restaurants/' + m.id + '" style="display:block;margin-top:8px;padding:11px 14px;background:#1B1814;color:#FFFDF7;text-align:center;font-size:15.5px;font-weight:800;text-decoration:none;border-radius:3px">查看詳情 →</a>' +
          '</div>'
        );
    });
  });
  </script>

  <!-- Map marker styles -->
  <style>
    .custom-marker { background: none !important; border: none !important; }
    .leaflet-popup-content { margin: 10px 14px !important; }
    .leaflet-popup-content-wrapper { border-radius: 10px !important; }
  </style>
</BaseLayout>
