---
import BaseLayout from '../layouts/BaseLayout.astro';
import restaurants from '../data/restaurants.json';
import stats from '../data/restaurant-stats.json';
import coords from '../data/restaurant-coords.json';

// Build marker data
// 只收有真實數值座標嘅記錄：restaurant-coords.json 有 3 筆 lat/lng = null（prec='area'），
// JSON.stringify 會保留 null → Leaflet 收到 [null,null] 會拋
// "Cannot read properties of null (reading 'lat')"，之後清單／markers 全部停。
const hasCoords = (id: number | string) => {
  const c = coords[id] as { lat?: unknown; lng?: unknown } | undefined;
  return !!c && typeof c.lat === 'number' && typeof c.lng === 'number';
};

const markers = restaurants
  .filter((r: { id: number }) => hasCoords(r.id))
  .map((r: { id: number; name_zh: string; name_en: string; district: string; address: string }) => ({
    id: r.id,
    name: r.name_zh || r.name_en || `${r.district}狗友善餐廳`,
    district: r.district,
    address: r.address,
    lat: coords[r.id].lat,
    lng: coords[r.id].lng,
  }));

// 分區 chips（SSR；點一粒＝地圖飛去嗰區 + 清單只列嗰區）
const districtCounts: Array<[string, number]> = Object.entries(
  markers.reduce((acc: Record<string, number>, m: { district: string }) => {
    acc[m.district] = (acc[m.district] || 0) + 1;
    return acc;
  }, {})
).sort((a, b) => (b[1] as number) - (a[1] as number));
---

<BaseLayout title="🗺️ 狗友善餐廳地圖" lang="zh">
  <div id="mpWrap" class="mp-wrap">

    <!-- 左欄（桌面）：標題＋分區 chips＋圖例 -->
    <div class="mp-main">
      <div class="mp-head">
        <h1 class="mp-title">🗺️ 餐廳地圖</h1>
        <p class="mp-sub">{stats.total} 間狗友善餐廳 · 㨂清單即飛去嗰間</p>
      </div>
      <div class="mp-chips" id="mpChips">
        <button type="button" class="mp-chip is-active" data-district="">全部 <span class="mp-chip-n">{markers.length}</span></button>
        {districtCounts.map(([d, n]) => (
          <button type="button" class="mp-chip" data-district={d}>{d} <span class="mp-chip-n">{n}</span></button>
        ))}
      </div>
      <p class="mp-legend">🖱️ 拖動地圖・滾輪放大縮細 · Click 標記或清單查餐廳</p>
    </div>

    <!-- 地圖（桌面釘右邊、可拖分線調闊度） -->
    <div class="mp-mapcol">
      <div id="all-restaurants-map" class="mp-map" data-markers={JSON.stringify(markers)}></div>
    </div>

    <!-- 餐廳清單（桌面喺左欄；手機喺地圖下面） -->
    <div class="mp-listwrap">
      <input type="text" id="mpSearch" class="mp-search" placeholder="搜尋餐廳名／地址…" />
      <div id="mpList" class="mp-list"></div>
      <p id="mpEmpty" class="mp-empty" hidden>搵唔到相關餐廳</p>
    </div>

    <div id="mpSplitter" class="lr-splitter" role="separator" aria-orientation="vertical" title="拖動調左右大細（雙擊還原）"></div>
  </div>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
  <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>
  <script src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.1.0/leaflet-maplibre-gl.js" is:inline></script>
  <script src="/basemap.js" is:inline></script>
  <script src="/desk-splitter.js" is:inline></script>
  <script is:inline>
  (function () {
    var DISTRICT_COLORS = {
      '中西區': '#8C2318', '灣仔區': '#D9432B', '東區': '#E9822B',
      '南區': '#C9A227', '油尖區': '#F6D77A', '深水埗區': '#8A9B4A',
      '九龍城區': '#4E7A3A', '黃大仙區': '#2F6F6B', '觀塘區': '#3D6B9A',
      '荃灣區': '#5B5EA6', '屯門區': '#7A5AA6', '元朗區': '#A64C86',
      '北區': '#B5467A', '大埔區': '#8C6D4F', '沙田區': '#6E8C7A',
      '西貢區': '#2F5D8C', '葵青區': '#A34B2A', '離島區': '#1E6E6A',
      '旺角區': '#E0A0B0'
    };
    var LINK_BASE = '/restaurants/';

    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    document.addEventListener('DOMContentLoaded', function () {
     try {
      var el = document.getElementById('all-restaurants-map');
      var listEl = document.getElementById('mpList');
      if (!el || typeof L === 'undefined') return;

      var markers;
      try {
        markers = JSON.parse(el.getAttribute('data-markers') || '[]');
      } catch (e) {
        el.innerHTML = '<div class="mp-fail">地圖資料載入失敗</div>';
        return;
      }
      if (!markers || markers.length === 0) {
        el.innerHTML = '<div class="mp-fail">暫無餐廳位置資料</div>';
        return;
      }

      var bounds = L.latLngBounds();
      markers.forEach(function (m) { if (isFinite(m.lat) && isFinite(m.lng)) bounds.extend([m.lat, m.lng]); });

      var map = L.map(el, {
        zoomControl: true,
        scrollWheelZoom: true
      }).fitBounds(bounds, { padding: [30, 30] });

      // Basemap: OpenFreeMap positron vector (keyless) with Esri Light Gray raster fallback
      NexiBasemap.add(map);

      var byId = {};
      markers.forEach(function (m) {
        if (!isFinite(m.lat) || !isFinite(m.lng)) return;
        var color = DISTRICT_COLORS[m.district] || '#C03818';
        var icon = L.divIcon({
          className: 'custom-marker',
          html: '<div style="width:24px;height:24px;display:flex;align-items:center;justify-content:center"><span style="width:14px;height:14px;background:' + color + ';border:2px solid #1B1814;border-radius:50%;box-shadow:0 1px 2px rgba(27,24,20,0.35);display:block"></span></div>',
          iconSize: [24, 24],
          iconAnchor: [12, 12],
          popupAnchor: [0, -8]
        });
        var mk = L.marker([m.lat, m.lng], { icon: icon }).addTo(map).bindPopup(
          '<div style="font-size:15px;line-height:1.5;min-width:180px">' +
          '<strong>' + esc(m.name) + '</strong><br>' +
          '<span style="color:#4A433A;font-size:14.5px">📍 ' + esc(m.district) + '</span><br>' +
          '<span style="color:#5C544A;font-size:14px">' + esc(m.address || '') + '</span><br>' +
          '<a href="' + LINK_BASE + m.id + '" style="display:block;margin-top:8px;padding:11px 14px;background:#1B1814;color:#FFFDF7;text-align:center;font-size:15.5px;font-weight:800;text-decoration:none;border-radius:3px">查看詳情 →</a>' +
          '</div>'
        );
        byId[m.id] = mk;
      });

      // ── 清單（同地圖同一批餐廳；分區 chips / 搜尋同步）──
      var filter = { district: '', q: '' };

      function matches(m) {
        if (filter.district && m.district !== filter.district) return false;
        var q = filter.q.trim().toLowerCase();
        if (q && (m.name + ' ' + m.address + ' ' + m.district).toLowerCase().indexOf(q) === -1) return false;
        return true;
      }

      function renderList() {
        if (!listEl) return;
        var html = [];
        var n = 0;
        for (var i = 0; i < markers.length; i++) {
          var m = markers[i];
          if (!matches(m)) continue;
          n++;
          html.push(
            '<div class="mp-row">' +
              '<button type="button" class="mp-item" data-id="' + m.id + '">' +
                '<span class="mp-item-name">' + esc(m.name) + '</span>' +
                '<span class="mp-item-meta">' + esc(m.district) + (m.address ? ' · ' + esc(m.address) : '') + '</span>' +
              '</button>' +
              '<a class="mp-go" href="' + LINK_BASE + m.id + '" aria-label="查看詳情">→</a>' +
            '</div>'
          );
        }
        listEl.innerHTML = html.join('');
        var empty = document.getElementById('mpEmpty');
        if (empty) empty.hidden = n > 0;
      }

      function fitTo(list, maxZoom) {
        var b = null;
        for (var i = 0; i < list.length; i++) {
          var m = list[i];
          if (!b) b = L.latLngBounds([m.lat, m.lng], [m.lat, m.lng]);
          else b.extend([m.lat, m.lng]);
        }
        if (b && b.isValid()) map.fitBounds(b, { padding: [30, 30], maxZoom: maxZoom || 16 });
      }

      function focusMarker(id) {
        var mk = byId[id];
        if (!mk) return;
        map.setView(mk.getLatLng(), 17, { animate: true });
        mk.openPopup();
      }

      if (listEl) {
        listEl.addEventListener('click', function (ev) {
          var t = ev.target;
          var b = t && t.closest ? t.closest('.mp-item') : null;
          if (!b) return;
          focusMarker(Number(b.getAttribute('data-id')));
        });
      }

      var searchEl = document.getElementById('mpSearch');
      if (searchEl) {
        searchEl.addEventListener('input', function () {
          filter.q = searchEl.value || '';
          renderList();
        });
      }

      var chipsEl = document.getElementById('mpChips');
      if (chipsEl) {
        chipsEl.addEventListener('click', function (ev) {
          var t = ev.target;
          var c = t && t.closest ? t.closest('.mp-chip') : null;
          if (!c) return;
          Array.prototype.forEach.call(chipsEl.querySelectorAll('.mp-chip'), function (x) { x.classList.remove('is-active'); });
          c.classList.add('is-active');
          filter.district = c.getAttribute('data-district') || '';
          renderList();
          var sub = markers.filter(function (m) { return filter.district ? m.district === filter.district : true; });
          fitTo(sub, filter.district ? 16 : 13);
        });
      }

      renderList();

      // 桌面（≥1000px）：中間分線可拖（同列表頁共用同一支 desk-splitter.js）
      if (window.NexiSplitter) {
        NexiSplitter.init({
          wrap: document.getElementById('mpWrap'),
          splitter: document.getElementById('mpSplitter'),
          getMap: function () { return map; },
          key: 'pet_map_w', defWidth: 460, minMap: 320, clampMin: 520, pad: 28
        });
      }

      window.addEventListener('resize', function () { map.invalidateSize(); });
     } catch (err) {
      // 唔好靜靜死：將錯誤寫落清單位，方便即刻見到（2026-10-05）
      if (listEl) listEl.innerHTML = '<div class="mp-fail">清單載入失敗：' + esc((err && err.message ? err.message : String(err)) + ' @ ' + String(err && err.stack || '').split('\n').slice(0,3).join(' | ')) + '</div>';
     }
    });
  })();
  </script>

  <!-- Map marker styles -->
  <style>
    .custom-marker { background: none !important; border: none !important; }
    .leaflet-popup-content { margin: 10px 14px !important; }
    .mp-fail { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 15px; color: var(--ink-3); }
  </style>
</BaseLayout>
