---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="📰 Pet News" lang="en">
  <div class="max-w-4xl mx-auto px-4 py-6 md:py-8">
    <h1 class="text-xl md:text-2xl font-bold text-near-black mb-1">📰 Pet News</h1>
    <p class="text-sm text-gray-500 mb-8">Latest Hong Kong pet news, events, and policy updates</p>

    <div class="empty-hero text-center">
      <span class="monogram mx-auto anim-float" style="width:72px;height:72px;font-size:36px" aria-hidden="true">📡</span>
      <p class="text-xl font-bold text-near-black mt-4 mb-2">Coming soon</p>
      <p class="text-base text-gray-600 mb-1">Daily auto-curated Hong Kong pet news, events, and policy updates</p>
      <p class="text-base text-gray-500 mb-6">This page will update automatically once the news pipeline is ready</p>
      <a href="/en" class="btn btn-primary no-underline">
        ← Back to restaurants and health guides
      </a>
    </div>
  </div>
</BaseLayout>