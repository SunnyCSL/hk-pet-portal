---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="📰 Pet News" lang="en">
  <div class="max-w-4xl mx-auto px-4 py-6 md:py-8">
    <h1 class="text-xl md:text-2xl font-bold text-near-black mb-1">📰 Pet News</h1>
    <p class="text-sm text-gray-500 mb-8">Latest Hong Kong pet news, events, and policy updates</p>

    <div class="text-center py-12 md:py-16 bg-warm-white rounded-xl border border-gray-100">
      <div class="text-5xl mb-4" aria-hidden="true">📡</div>
      <p class="text-lg md:text-xl font-semibold text-near-black mb-2">Coming soon</p>
      <p class="text-sm text-gray-500 mb-1">Daily auto-curated Hong Kong pet news, events, and policy updates</p>
      <p class="text-xs text-gray-500 mb-6">This page will update automatically once the news pipeline is ready</p>
      <a href="/en" class="inline-flex items-center gap-1.5 bg-brand text-white px-5 py-2.5 rounded-xl text-sm font-medium no-underline hover:bg-brand/90 transition">
        ← Back to restaurants and health guides
      </a>
    </div>
  </div>
</BaseLayout>