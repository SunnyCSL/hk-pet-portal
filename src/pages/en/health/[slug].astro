---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import articles from '../../../data/health-articles.json';
import videoArticles from '../../../data/video-articles.json';

// Phase 2 — EN article mirror of /health/[slug].astro.
// Rule: if content_html_en is empty/missing, do NOT emit a route (→ 404 in prod).
// getStaticPaths only includes articles with non-empty content_html_en.
export function getStaticPaths() {
  return (articles as any[])
    .filter((a) => typeof a.content_html_en === 'string' && a.content_html_en.trim().length > 0)
    .map((a) => ({
      params: { slug: a.slug },
      props: { article: a },
    }));
}

const { article } = Astro.props;

// --- description / meta ---
function decodeEntities(html: string): string {
  return html
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&amp;/g, '&')
    .replace(/&nbsp;/g, ' ');
}
function stripTags(html: string): string {
  return html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
}
// content_html_en in JSON is plain HTML (not double-encoded), so deriveDesc
// here is simpler than the zh page version. Falls back to article's first
// <p> if desc_en is missing.
function deriveDesc(html: string, maxLen = 150): string {
  const paragraphs: string[] = [];
  const re = /<p[^>]*>([\s\S]*?)<\/p>/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(html)) !== null) paragraphs.push(stripTags(m[1]));
  let text = paragraphs.find((t) => t.length >= 30) || paragraphs[0] || stripTags(html);
  text = text.replace(/^#\s*/, '').trim();
  return text.length > maxLen ? text.slice(0, maxLen).trimEnd() + '…' : text;
}
const metaDescription = (article.desc_en && String(article.desc_en).trim()) || deriveDesc(article.content_html_en || '');

// --- date / keywords ---
const MONTH_MAP: Record<string, string> = {
  Jan: '01', Feb: '02', Mar: '03', Apr: '04', May: '05', Jun: '06',
  Jul: '07', Aug: '08', Sep: '09', Oct: '10', Nov: '11', Dec: '12',
};
function deriveDateIso(dateStr: string): string {
  const m = (dateStr || '').trim().match(/^([A-Za-z]+)\s*(\d{1,2})$/);
  if (!m) return '2026-01-01';
  const month = MONTH_MAP[m[1]] || '01';
  const day = m[2].padStart(2, '0');
  return `2026-${month}-${day}`;
}
const articleDateIso = (article as any).date_iso || deriveDateIso(article.date || '');
const articleKeywords = Array.isArray(article.tags_en) && article.tags_en.length
  ? article.tags_en.join(', ')
  : (Array.isArray(article.tags) ? article.tags.join(', ') : '');

// --- Article JSON-LD (EN locale) ---
const articleLd: object = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title_en,
  description: metaDescription,
  ...(articleKeywords ? { keywords: articleKeywords } : {}),
  inLanguage: 'en-HK',
  datePublished: articleDateIso,
  dateModified: articleDateIso,
  author: { '@type': 'Organization', name: 'HK Pet Portal' },
  publisher: { '@type': 'Organization', name: 'HK Pet Portal' },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/en/health/${article.slug}`, Astro.site || 'https://hk-pet-portal.vercel.app').toString(),
  },
  articleSection: article.catName_en || article.catName || 'Pet Health',
};

// --- optional video embed (Phase 3) ---
interface VideoMapping {
  slug: string;
  video_id: string;
  topic: string;
  caption_zh: string;
  caption_en: string;
}
const videoMap: VideoMapping[] = videoArticles as VideoMapping[];
const videoEntry = videoMap.find((v) => v.slug === article.slug);
---

<BaseLayout
  title={article.title_en}
  description={metaDescription}
  ogType="article"
  publishedTime={articleDateIso}
  modifiedTime={articleDateIso}
  jsonLd={articleLd}
  lang="en"
>
  <div class="max-w-3xl mx-auto px-4 py-6 md:py-8">
    <a href="/en/health" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-brand no-underline mb-4">
      ← Health Library
    </a>

    <div class="mb-6">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-[10px] bg-brand-light text-brand/80 px-2 py-0.5 rounded-full font-medium">{article.catName_en || article.catName}</span>
        <span class="text-[10px] text-gray-300">{Array.isArray(article.tags_en) && article.tags_en.length ? article.tags_en.join(', ') : (Array.isArray(article.tags) ? article.tags.join(', ') : '')}</span>
      </div>
      <h1 class="text-xl md:text-2xl font-bold text-near-black leading-tight">{article.emoji} {article.title_en}</h1>
      {(article.source_en || article.source) && <p class="text-xs text-gray-400 mt-2">{article.source_en || article.source}</p>}
    </div>

    <div class="bg-white rounded-xl border border-gray-100 p-4 md:p-6">
      <div class="prose-custom">
        {article.content_html_en}
      </div>
    </div>

    {videoEntry && (
      <VideoEmbed
        videoId={videoEntry.video_id}
        titleZh={videoEntry.caption_zh}
        titleEn={videoEntry.caption_en}
        lang="en"
      />
    )}

    {article.disclaimer_en && (
      <div class="mt-6 bg-amber-50 border border-amber-100 rounded-xl p-4">
        <p class="text-xs text-amber-700 leading-relaxed">{article.disclaimer_en}</p>
      </div>
    )}
  </div>
</BaseLayout>