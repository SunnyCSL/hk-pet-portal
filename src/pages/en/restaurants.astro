  '上水','粉嶺',
  '大埔',
  '沙田','大圍','火炭',
  '西貢','將軍澳','坑口','寶琳','調景嶺','康城','清水灣',
  '葵涌','葵芳','青衣',
  '東涌','愉景灣','迪士尼','機場','大澳','長洲','南丫島','坪洲',
];

const ALIAS_GROUPS: Array<{ names: string[]; keys: string[] }> = [
  { names: ['奧運','olympic','olympian'], keys: ['奧海城','海泓道','大角咀','利奧坊','海帆道','匯翔道','櫻桃街','奧柏'] },
  { names: ['旺角東'], keys: ['旺角','太子'] },
  { names: ['西九龍','west kowloon','elements','圓方'], keys: ['西九龍','柯士甸','圓方','elements'] },
  { names: ['科學園','science park'], keys: ['科學園','白石角'] },
  { names: ['數碼港','cyberport'], keys: ['數碼港','薄扶林'] },
  { names: ['太古'], keys: ['太古','鰂魚涌'] },
  { names: ['將軍澳'], keys: ['將軍澳','坑口','寶琳','調景嶺','康城'] },
  { names: ['東涌'], keys: ['東涌','愉景灣'] },
  { names: ['馬鞍山'], keys: ['馬鞍山','烏溪沙'] },
  { names: ['機場','airport'], keys: ['機場','赤鱲角','航天城'] },
  { names: ['迪士尼','disneyland'], keys: ['迪士尼','竹篙灣'] },
  { names: ['中文大學','cuhk'], keys: ['中文大學','馬料水'] },
  { names: ['香港科技大學','hkust'], keys: ['香港科技大學','清水灣'] },
  { names: ['香港大學','hku'], keys: ['香港大學','薄扶林'] },
  { names: ['海洋公園','ocean park'], keys: ['海洋公園','黃竹坑'] },
  { names: ['黃金海岸','gold coast'], keys: ['黃金海岸','青山公路'] },
  { names: ['天水圍'], keys: ['天水圍','天慈'] },
];

// Display-name mapping (English) for area-centre keys. Used only for the area
// header label so e.g. "奧運" reads as "Olympic" in the EN UI. Fallback is the
// raw CJK key when no mapping exists.
const AREA_NAME_EN: Record<string, string> = {
  '奧運': 'Olympic',
  '旺角': 'Mong Kok',
  '旺角東': 'Mong Kok East',
  '太子': 'Prince Edward',
  '大角咀': 'Tai Kok Tsui',
