    '火炭': 'Fo Tan',
    '西貢': 'Sai Kung',
    '將軍澳': 'Tseung Kwan O',
    '坑口': 'Hang Hau',
    '寶琳': 'Po Lam',
    '調景嶺': 'Tiu Keng Leng',
    '康城': 'LOHAS Park',
    '清水灣': 'Clear Water Bay',
    '葵涌': 'Kwai Chung',
    '葵芳': 'Kwai Fong',
    '青衣': 'Tsing Yi',
    '東涌': 'Tung Chung',
    '愉景灣': 'Discovery Bay',
    '迪士尼': 'Hong Kong Disneyland',
    '機場': 'Airport',
    '大澳': 'Tai O',
    '長洲': 'Cheung Chau',
    '南丫島': 'Lamma Island',
    '坪洲': 'Peng Chau',
    '馬鞍山': 'Ma On Shan',
    '科學園': 'Science Park',
    '白石角': 'Pak Shek Kok',
  };

  function detectSubArea(addr, name) {
    var combined = (addr || '') + ' ' + (name || '');
    for (var i = 0; i < SUB_AREAS.length; i++) {
      if (combined.indexOf(SUB_AREAS[i]) !== -1) return SUB_AREAS[i];
    }
    return null;
  }

  var PAGE_SIZE = 50;

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // ---- Build the unified index (906 entries, with lat/lng/prec) ----
  var INDEX = [];
  function buildKey(nameZh, nameEn, address, district, extras) {
    var base = [nameZh || '', nameEn || '', address || '', district || '']
      .join(' ')
      .toLowerCase();
    return base + ' ' + (extras || '');
  }

  // 1) Static SSR cards (first 50) — prefer precomputed data-key.
  var staticEls = Array.prototype.slice.call(document.querySelectorAll('#restaurant-list .restaurant-item:not([data-island-card="1"])'));
  for (var s = 0; s < staticEls.length; s++) {
    var el = staticEls[s];
    var idMatch = (el.getAttribute('href') || '').match(/\/en\/restaurants\/(\d+)/);
    if (!idMatch) continue;
    var sid = parseInt(idMatch[1], 10);
    var sKey = el.getAttribute('data-key') || '';
    var sName = el.getAttribute('data-name') || '';
    var sAddr = el.getAttribute('data-addr') || '';
    var sDist = el.getAttribute('data-district') || '';
    var sLat = el.getAttribute('data-lat');
    var sLng = el.getAttribute('data-lng');
    var sPrec = el.getAttribute('data-prec');
    if (!sKey) {
      sKey = buildKey('', sName, sAddr, sDist, '');
    }
    INDEX.push({
      id: sid,
      key: sKey,
      district: sDist,
      name_zh: '',
      name_en: sName,
      address: sAddr,
      lat: sLat === '' || sLat == null ? null : Number(sLat),
      lng: sLng === '' || sLng == null ? null : Number(sLng),
      prec: sPrec === '' || sPrec == null ? null : sPrec,
    });
  }

  // 2) Island entries (51..906): [id, name_zh, name_en, district, address, extras, lat, lng, prec].
  var rawIsland = [];
  try { rawIsland = JSON.parse(document.getElementById('rest-data').textContent || '{}').restaurants || []; } catch (e) { rawIsland = []; }
  var seenIds = {};
  INDEX.forEach(function (e) { seenIds[e.id] = true; });
  for (var i = 0; i < rawIsland.length; i++) {
    var r = rawIsland[i];
    var id = r[0], nzh = r[1] || '', nen = r[2] || '', dist = r[3] || '', addr = r[4] || '', extras = r[5] || '';
    if (seenIds[id]) continue;
    seenIds[id] = true;
    INDEX.push({
      id: id,
      key: buildKey(nzh, nen, addr, dist, extras),
      district: dist,
      name_zh: nzh,
      name_en: nen,
      address: addr,
      lat: r[6] == null ? null : Number(r[6]),
      lng: r[7] == null ? null : Number(r[7]),
      prec: r[8] || null,
    });
  }

  // 3) Area-centre table. Read once on script init.
  var AREA_CENTRES = {};
  try { AREA_CENTRES = JSON.parse(document.getElementById('area-centres').textContent || '{}') || {}; } catch (e) { AREA_CENTRES = {}; }
  // Sort keys by length DESC so longest match wins (e.g. '西九龍' before '九龍').
  var AREA_KEYS_SORTED = Object.keys(AREA_CENTRES).sort(function (a, b) { return b.length - a.length; });

  // ---- Tokenizer ----
  // Split on spaces/punctuation, lowercased. Inserts a boundary at CJK↔alnum
  // transitions so e.g. "OlympicTai" → ["olympictai"] (no useful split).
  function tokenize(s) {
    if (!s) return [];
    var str = String(s).toLowerCase().replace(/\u3000/g, ' ');
    str = str.replace(/[、，,;；/\\|+·．]/g, ' ');
    str = str.replace(/([一-鿿])([0-9a-z%'&.\-])/g, '$1 $2');
    str = str.replace(/([0-9a-z%'&.\-])([一-鿿])/g, '$1 $2');
    return str.split(/\s+/).filter(Boolean);
  }

  function matchKey(key, tokens) {
    for (var t = 0; t < tokens.length; t++) {
      var tok = tokens[t];
      if (tok.length === 0) continue;
      if (key.indexOf(tok) === -1) return false;
    }
    return true;
  }

  function matchDistrict(districtActive, entry) {
    if (!districtActive) return true;
    return entry.district === districtActive;
  }

  // New algorithm (area-nearby-search v2) — mirrors zh 1:1:
  //   1. tokenize(query) and detect activeArea (longest area-centre key found in
  //      the lowercased query).
  //   2. No activeArea → legacy token-AND filter, dataset order, no chips.
  //   3. activeArea + filterTokens empty (pure area query):
  //        results = token-matched ∪ records within current radius of centre;
  //        sort by eff = dist + (prec=='area' ? 400 : 0); null-dist last;
  //        radius chips visible.
  //   4. activeArea + filterTokens non-empty (e.g. "Olympic Outback"):
  //        results = INDEX records whose key contains ALL filterTokens (no radius
  //        union); sort by eff above; radius chips hidden.
  function runFilter(query, districtActive) {
    var tokens = tokenize(query);
    // Detect activeArea: longest area-centre key fully contained in query.
    var activeArea = null;
    if (query && query.trim()) {
      var qLower = query.toLowerCase().trim();
      for (var ai = 0; ai < AREA_KEYS_SORTED.length; ai++) {
        var k = AREA_KEYS_SORTED[ai];
        if (k && qLower.indexOf(k) !== -1) { activeArea = k; break; }
      }
    }
    if (!activeArea) {
      // Non-area mode — legacy behaviour: token-AND filter, dataset order.
      var out0 = [];
      for (var i = 0; i < INDEX.length; i++) {
        var e0 = INDEX[i];
        if (!matchDistrict(districtActive, e0)) continue;
        if (tokens.length > 0 && !matchKey(e0.key, tokens)) continue;
        out0.push(e0.id);
      }
      return { ids: out0, areaMode: false, areaName: null, showChips: false, dist: {} };
    }
    // Area-mode. Split query into activeArea + filterTokens (rest after removing
    // the area-key substring once).
    var qLower2 = query.toLowerCase().trim();
    var rest = qLower2.replace(activeArea.toLowerCase(), ' ', 1);
    var filterTokens = tokenize(rest);
    var centre = AREA_CENTRES[activeArea];
    var clat = centre.lat, clng = centre.lng;
    var radius = (state.radius == null) ? 1000 : state.radius;
    var byId = {};
    var distById = {};
    function distOfEntry(em) {
      return (em.lat != null && em.lng != null) ? haversine(clat, clng, em.lat, em.lng) : null;
    }
    if (filterTokens.length > 0) {
      // Pure keyword filter (no radius expansion). Still compute distance for
      // sorting + display, and skip records with no district match.
      for (var fi = 0; fi < INDEX.length; fi++) {
        var ef = INDEX[fi];
        if (!matchDistrict(districtActive, ef)) continue;
        if (!matchKey(ef.key, filterTokens)) continue;
        byId[ef.id] = true;
        distById[ef.id] = distOfEntry(ef);
      }
    } else {
      // Pure area query: union of token-matched (against the FULL query tokens,
      // which is just the area-key substring) + records within current radius.
      for (var mi = 0; mi < INDEX.length; mi++) {
        var em = INDEX[mi];
        if (!matchDistrict(districtActive, em)) continue;
        if (tokens.length > 0 && !matchKey(em.key, tokens)) continue;
        byId[em.id] = true;
        distById[em.id] = distOfEntry(em);
      }
      if (radius > 0) {
        for (var ki = 0; ki < INDEX.length; ki++) {
          var e2 = INDEX[ki];
          if (byId[e2.id]) continue;
          if (!matchDistrict(districtActive, e2)) continue;
          if (e2.lat == null || e2.lng == null) continue;
          var d2 = haversine(clat, clng, e2.lat, e2.lng);
          if (d2 <= radius) {
            byId[e2.id] = true;
            distById[e2.id] = d2;
          }
        }
      } else {
        // "All" radius: include every record (even no-coord).
        for (var ni = 0; ni < INDEX.length; ni++) {
          var en = INDEX[ni];
          if (byId[en.id]) continue;
          if (!matchDistrict(districtActive, en)) continue;
          byId[en.id] = true;
          distById[en.id] = null;
        }
      }
    }
    // Sort by eff = dist + (prec=='area' ? 400 : 0); null dist last.
    var entries = [];
    for (var id in byId) {
      var ent = null;
      for (var lj = 0; lj < INDEX.length; lj++) { if (INDEX[lj].id === Number(id)) { ent = INDEX[lj]; break; } }
      entries.push({ id: Number(id), dist: distById[id], prec: ent ? ent.prec : null });
    }
    entries.sort(function (a, b) {
      if (a.dist == null && b.dist == null) return 0;
      if (a.dist == null) return 1;
      if (b.dist == null) return -1;
      var aEff = a.dist + (a.prec === 'area' ? 400 : 0);
      var bEff = b.dist + (b.prec === 'area' ? 400 : 0);
      return aEff - bEff;
    });
    var ids = [];
    for (var si = 0; si < entries.length; si++) ids.push(entries[si].id);
    return {
      ids: ids,
      areaMode: true,
      areaName: activeArea,
      showChips: filterTokens.length === 0,
      dist: distById,
    };
  }

  // Haversine in metres. Pure JS — no Math.asin2.
  function haversine(lat1, lng1, lat2, lng2) {
    var R = 6371000.0;
    var toRad = function (x) { return x * Math.PI / 180; };
    var dLat = toRad(lat2 - lat1);
    var dLng = toRad(lng2 - lng1);
    var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
            Math.sin(dLng / 2) * Math.sin(dLng / 2);
    var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  // Format metres → "320 m" or "~320 m" (approx prefix comes from caller).
  // Returns null when distance is null.
  function formatDistanceEn(d) {
    if (d == null) return null;
    if (d < 1000) return Math.round(d) + ' m';
    return (d / 1000).toFixed(1) + ' km';
  }
  // Walking minutes from metres (80 m/min). Round to nearest integer, minimum 1,
  // and only show when ≤ 1200m to avoid noisy 30-min labels.
  function walkingMinutes(d) {
    if (d == null || d > 1200) return null;
    return Math.max(1, Math.round(d / 80));
  }

  // ---- Render helpers ----
  function makeCardFromEntry(e, dist) {
    var nameEn = e.name_en || e.name_zh || (e.district || '') + ' dog-friendly restaurant';
    var sub = detectSubArea(e.address || '', e.name_en || e.name_zh || '');
    var subLabel = sub || e.district || '';
    var addrHtml = e.address
      ? '<span class="mx-1.5 text-gray-200">·</span><span class="text-gray-300">' + escapeHtml(e.address) + '</span>'
      : '';
    var distHtml = '';
    if (dist != null) {
      var approx = e.prec === 'area' ? '~' : '';
      var dStr = formatDistanceEn(dist);
      var mins = walkingMinutes(dist);
      var walk = mins != null ? ' · ' + mins + '-min walk' : '';
      distHtml = '<span class="dist-badge text-xs text-gray-400 whitespace-nowrap">' + escapeHtml(approx + dStr + walk) + '</span>';
    } else {
      distHtml = '<span class="dist-badge text-xs text-gray-400 hidden whitespace-nowrap"></span>';
    }
    return '<a href="/en/restaurants/' + e.id + '"'
      + ' class="restaurant-item group bg-white rounded-xl px-4 py-3 border border-gray-100 hover:border-brand/30 hover:shadow-sm transition-all no-underline"'
      + ' data-name="' + escapeHtml((e.name_en || e.name_zh || '').toLowerCase()) + '"'
      + ' data-district="' + escapeHtml(e.district || '') + '"'
      + ' data-addr="' + escapeHtml((e.address || '').toLowerCase()) + '"'
      + ' data-key="' + escapeHtml(e.key || '') + '">'
      + '<div class="flex items-center gap-3">'
      + '<div class="w-1 h-10 bg-brand/20 rounded-full shrink-0"></div>'
      + '<div class="min-w-0 flex-1">'
      + '<h3 class="font-semibold text-sm md:text-base text-near-black group-hover:text-brand transition-colors truncate">' + escapeHtml(nameEn) + '</h3>'
      + '<p class="text-xs text-gray-500 mt-0.5 truncate">'
      + '<span class="inline-flex items-center gap-1">'
      + '<span class="text-gray-300">📍</span> '
      + '<span class="sub-area-label">' + escapeHtml(subLabel) + '</span>'
      + '</span>' + addrHtml + '</p>'
      + '</div>'
      + '<div class="flex items-center gap-2 shrink-0">'
      + distHtml
      + '<span class="text-gray-300 group-hover:text-brand transition-colors"><span class="text-xs">→</span></span>'
      + '</div>'
      + '</div></a>';
  }

  // Group-header labels (EN). Bucket key 0/1/2/3/4.
  var GROUP_LABELS_EN = [
    'Within a 5-min walk',
    'Within a 15-min walk',
    'A short drive',
    'Further away',
    'Approximate location',
  ];
  function bucketFor(d, hasPrec) {
    if (d == null) return -1;
    if (!hasPrec) return 4;
    if (d <= 400) return 0;
    if (d <= 1200) return 1;
    if (d <= 3000) return 2;
    return 3;
  }

  function findIndexEntry(id) {
    for (var i = 0; i < INDEX.length; i++) {
      if (INDEX[i].id === id) return INDEX[i];
    }
    return null;
  }

  // ---- Pagination / state ----
  var state = { page: 1, radius: 1000 };

  function currentMatches() {
    var q = document.getElementById('search-input').value || '';
    var d = document.body.getAttribute('data-active-district') || '';
    return runFilter(q, d);
  }

  function renderAreaHeader(areaName, total, showChips) {
    var header = document.getElementById('area-header');
    var labelEl = document.getElementById('area-header-label');
    var metaEl = document.getElementById('area-header-meta');
    var chipsEl = document.getElementById('area-radius-chips');
    if (!header) return;
    if (!areaName) { header.classList.add('hidden'); return; }
    header.classList.remove('hidden');
    // Header format: "<English area name> · <count> venues (nearest first)"
    var displayName = (AREA_NAME_EN && AREA_NAME_EN[areaName]) || areaName;
    labelEl.textContent = displayName;
    metaEl.textContent = total + ' venues (nearest first)';
    if (chipsEl) chipsEl.style.display = showChips ? '' : 'none';
    var chips = header.querySelectorAll('.radius-chip');
    for (var i = 0; i < chips.length; i++) {
      var c = chips[i];
      var r = Number(c.getAttribute('data-radius'));
      if (r === state.radius) {
        c.className = c.className.replace(/bg-gray-50 text-gray-500 hover:bg-gray-100/g, 'bg-brand text-white');
      } else {
        c.className = c.className.replace(/bg-brand text-white/g, 'bg-gray-50 text-gray-500 hover:bg-gray-100');
      }
    }
  }

  function radiusLabelEn(r) {
    if (!r || r === 0) return 'All';
    if (r === 500) return '500 m';
    if (r === 1000) return '1 km';
    if (r === 2000) return '2 km';
    return (r < 1000 ? r + ' m' : (r / 1000).toFixed(1) + ' km');
  }

  function groupHeaderEl(label) {
    var div = document.createElement('div');
    div.className = 'area-group-header bg-gray-50 text-xs text-gray-500 px-3 py-1.5 rounded-full self-start mt-2 mb-0';
    div.textContent = label;
    div.setAttribute('data-area-group', '1');
    return div;
  }

  function rebuildPage() {
    var list = document.getElementById('restaurant-list');
    if (!list) return;
    var res = currentMatches();
    var ids = res.ids;
    var distMap = res.dist || {};
    var total = ids.length;
    var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (state.page > totalPages) state.page = totalPages;
    if (state.page < 1) state.page = 1;
    var start = (state.page - 1) * PAGE_SIZE;
    var end = start + PAGE_SIZE;
    var visibleIds = ids.slice(start, end);
    var visibleSet = {};
    for (var vi = 0; vi < visibleIds.length; vi++) visibleSet[visibleIds[vi]] = true;

    // Update distance badges on static SSR cards.
    Array.prototype.forEach.call(list.querySelectorAll('.restaurant-item:not([data-island-card="1"])'), function (el) {
      var idMatch = (el.getAttribute('href') || '').match(/\/en\/restaurants\/(\d+)/);
      var id = idMatch ? parseInt(idMatch[1], 10) : null;
      var badge = el.querySelector('.dist-badge');
      var d = id != null ? distMap[id] : null;
      if (badge) {
        if (d != null) {
          var entry = findIndexEntry(id);
          var approx = entry && entry.prec === 'area' ? '~' : '';
          var dStr = formatDistanceEn(d);
          var mins = walkingMinutes(d);
          var walk = mins != null ? ' · ' + mins + '-min walk' : '';
          badge.textContent = approx + dStr + walk;
          badge.classList.remove('hidden');
        } else {
          badge.textContent = '';
          badge.classList.add('hidden');
        }
      }
    });

    // Hide/show static SSR cards by id.
    Array.prototype.forEach.call(list.querySelectorAll('.restaurant-item'), function (el) {
      var idMatch = (el.getAttribute('href') || '').match(/\/en\/restaurants\/(\d+)/);
      var id = idMatch ? parseInt(idMatch[1], 10) : null;
      if (id == null) { el.style.display = 'none'; return; }
      el.style.display = visibleSet[id] ? '' : 'none';
    });

    // Strip previously-injected island cards AND area group headers.
    var extras = list.querySelectorAll('[data-island-card="1"]');
    for (var xi = 0; xi < extras.length; xi++) {
      var ex = extras[xi];
      if (ex.parentNode) ex.parentNode.removeChild(ex);
    }
    var groups = list.querySelectorAll('[data-area-group="1"]');
    for (var gi = 0; gi < groups.length; gi++) {
      var g = groups[gi];
      if (g.parentNode) g.parentNode.removeChild(g);
    }

    // In area-mode the sorted order can disagree with the SSR DOM order (which
    // is by id), so hide ALL static SSR cards and render everything from the
    // island. The result list then reflects the sorted `visibleIds` exactly.
    if (res.areaMode) {
      Array.prototype.forEach.call(list.querySelectorAll('.restaurant-item:not([data-island-card="1"])'), function (el) {
        el.style.display = 'none';
      });
    }

    // Render visible ids (in the sorted order from runFilter).
    var lastBucket = -2;
    for (var idi = 0; idi < visibleIds.length; idi++) {
      var id = visibleIds[idi];
      if (res.areaMode) {
        var entry2 = findIndexEntry(id);
        var d = distMap[id] != null ? distMap[id] : null;
        var prec = entry2 ? entry2.prec : null;
        var b = bucketFor(d, prec !== 'area');
        if (b !== lastBucket) {
          if (b >= 0 && b < GROUP_LABELS_EN.length) {
            list.appendChild(groupHeaderEl(GROUP_LABELS_EN[b]));
          }
          lastBucket = b;
        }
      }
      var staticCard = res.areaMode ? null : list.querySelector('#restaurant-list .restaurant-item[data-key][href$="/en/restaurants/' + id + '"]:not([data-island-card="1"])');
      if (staticCard && staticCard.offsetParent !== null) continue;
      var entry = findIndexEntry(id);
      if (!entry) continue;
      var tmp = document.createElement('div');
      tmp.innerHTML = makeCardFromEntry(entry, distMap[id] != null ? distMap[id] : null);
      var node = tmp.firstChild;
      if (node) {
        node.setAttribute('data-island-card', '1');
        list.appendChild(node);
      }
    }

    var countEl = document.getElementById('result-count');
    if (countEl) countEl.textContent = total + ' venues';
    var cur = document.getElementById('pg-current');
    var tot = document.getElementById('pg-total');
    if (cur) cur.textContent = String(state.page);
    if (tot) tot.textContent = String(totalPages);
    var prev = document.getElementById('pg-prev');
    var next = document.getElementById('pg-next');
    if (prev) prev.disabled = state.page <= 1;
    if (next) next.disabled = state.page >= totalPages;

    var empty = document.getElementById('empty-state');
    if (empty) empty.classList.toggle('hidden', total > 0);
    var clear = document.getElementById('clear-filter');
    var qNow = (document.getElementById('search-input').value || '').trim();
    var dNow = document.body.getAttribute('data-active-district') || '';
    if (clear) clear.classList.toggle('hidden', !qNow && !dNow);

    var pager = document.getElementById('pager');
    if (pager) pager.style.display = total > PAGE_SIZE ? '' : 'none';

    // Area-mode header (toggle visibility + label).
    renderAreaHeader(res.areaMode ? res.areaName : null, total, !!res.showChips);
  }

  function filterList() {
    state.page = 1;
    rebuildPage();
  }

  function setDistrict(d) {
    document.querySelectorAll('[id^="pill-"]').forEach(function (el) {
      el.className = el.className.replace(/bg-brand text-white/g, 'bg-gray-50 text-gray-500');
    });
    if (d) {
      var pill = document.getElementById('pill-' + d.replace(/\s/g, ''));
      if (pill) pill.className = pill.className.replace(/bg-gray-50 text-gray-500/g, 'bg-brand text-white');
    } else {
      var pAll = document.getElementById('pill-all');
      if (pAll) pAll.className = pAll.className.replace(/bg-gray-50 text-gray-500/g, 'bg-brand text-white');
    }
    document.querySelectorAll('[data-active-district]').forEach(function (el) { el.removeAttribute('data-active-district'); });
    if (d) document.body.setAttribute('data-active-district', d);
    filterList();
  }

  function resetFilter() {
    document.getElementById('search-input').value = '';
    state.radius = 1000;
    setDistrict('');
  }

  function setRadius(r) {
    state.radius = r;
    state.page = 1;
    rebuildPage();
  }

  // ---- Search input: live re-filter on each keystroke ----
  document.getElementById('search-input').addEventListener('input', function () {
    filterList();
  });

  document.getElementById('pg-prev').addEventListener('click', function () {
    if (state.page > 1) { state.page--; rebuildPage(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });
  document.getElementById('pg-next').addEventListener('click', function () {
    state.page++; rebuildPage(); window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ---- Sub-area labels on initial static cards (cosmetic, no behaviour change) ----
  document.querySelectorAll('#restaurant-list .sub-area-label').forEach(function (el) {
    var addr = el.getAttribute('data-addr') || '';
    var name = el.getAttribute('data-name') || '';
    var sub = detectSubArea(addr, name);
    if (sub) el.textContent = sub;
  });

  // ---- On load: apply URL params + initial render ----
  window.addEventListener('DOMContentLoaded', function () {
    var params = new URLSearchParams(window.location.search);
    var q = params.get('q');
    var d = params.get('district');
    if (q) document.getElementById('search-input').value = q;
    if (d) setDistrict(d);
    rebuildPage();
  });
  </script>
</BaseLayout>
