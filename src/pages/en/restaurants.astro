import BaseLayout from '../../layouts/BaseLayout.astro';
import restaurants from '../../data/restaurants.json';
import stats from '../../data/restaurant-stats.json';
import areaCentres from '../../data/area-centres.json';
import restaurantCoords from '../../data/restaurant-coords.json';

const districts = [...new Set(restaurants.map((r: { district: string }) => r.district))].sort();

// Phase 2 (fix/restaurant-search-v2): unified search index across all 906 records.
// Build-time: each record gets a precomputed `search_key` = base + extras.
// Extras include SUB_AREAS detected from address+name AND any alias group
// whose `keys` (real address/name substrings) match the base.
// First 50 cards keep SSR (data-key/data-name/data-district/data-addr/data-lat/data-lng/data-prec),
// island holds 51..906 as compact arrays so the rendered HTML stays compact while
// the client can do proper token + AND search across the whole dataset.
// EN version mirrors the zh version 1:1; cards prefer name_en. Mirrors zh for
// area-mode (radius union, distance-sorted cards, "nearest first" header).
const PAGE_SIZE = 50;
const STATIC_COUNT = 50;

// Sub-area names (shared with client). Order matters: longer/more specific
// first so e.g. '西九龍' wins over '九龍' if both ever overlapped.
const SUB_AREAS = [
  '馬鞍山','科學園','白石角',
