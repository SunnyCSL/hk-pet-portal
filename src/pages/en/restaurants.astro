---
import BaseLayout from '../../layouts/BaseLayout.astro';
import restaurants from '../../data/restaurants.json';
import stats from '../../data/restaurant-stats.json';
import areaCentres from '../../data/area-centres.json';
import areaSlugs from '../../data/area-slugs.json';
import areaNames from '../../data/area-names.json';
import restaurantCoords from '../../data/restaurant-coords.json';
import restaurantTypes from '../../data/restaurant-types.json';

// feat/restaurant-types: zh category → en display name. Mirrors the table in
// /tmp/cuisine_rules.md. Records absent from restaurantTypes have no inferred
// cuisine and so no chip is rendered for them.
const CUISINE_EN_MAP: Record<string, string> = {
  '咖啡': 'Coffee',
  '酒吧': 'Bar',
  '茶飲': 'Bubble tea',
  '茶餐廳': 'Cha chaan teng',
  '港式大排檔': 'Dai pai dong',
  '港式燒味': 'Cantonese roast',
  '火鍋': 'Hot pot',
  '點心': 'Dim sum',
  '壽司／刺身': 'Sushi & sashimi',
  '拉麵／烏冬': 'Ramen & udon',
  '日式': 'Japanese',
  '日式燒肉': 'Yakiniku',
  '韓式': 'Korean',
  '泰越星馬': 'Thai / Viet / SEA',
  '西餐': 'Western',
  '法式': 'French',
  '中菜': 'Chinese',
  '中式地方菜': 'Regional Chinese',
  '粉麵': 'Noodles',
  '粥品': 'Congee',
  '海鮮': 'Seafood',
  '串燒燒烤': 'Skewers & BBQ',
  '素食': 'Vegetarian',
  '甜品／烘焙': 'Dessert & bakery',
  '印度尼泊爾': 'Indian & Nepali',
  '台灣': 'Taiwanese',
};

const districts = [...new Set(restaurants.map((r: { district: string }) => r.district))].sort();

// Phase 2 (fix/restaurant-search-v2): unified search index across all 906 records.
// Build-time: each record gets a precomputed `search_key` = base + extras.
// Extras include SUB_AREAS detected from address+name AND any alias group
// whose `keys` (real address/name substrings) match the base.
// First 50 cards keep SSR (data-key/data-name/data-district/data-addr/data-lat/data-lng/data-prec),
// island holds 51..906 as compact arrays so the rendered HTML stays compact while
// the client can do proper token + AND search across the whole dataset.
// EN version mirrors the zh version 1:1; cards prefer name_en. Mirrors zh for
// area-mode (radius union, distance-sorted cards, "nearest first" header).
const PAGE_SIZE = 50;
const STATIC_COUNT = 50;

// Sub-area names (shared with client). Order matters: longer/more specific
// first so e.g. '西九龍' wins over '九龍' if both ever overlapped.
const SUB_AREAS = [
  '馬鞍山','科學園','白石角',
  '香港仔','黃竹坑','海洋公園','淺水灣','赤柱','薄扶林','數碼港','鴨脷洲',
  '中環','上環','西營盤','堅尼地城','石塘咀','半山','山頂','金鐘',
  '銅鑼灣','跑馬地','大坑','天后',
  '北角','鰂魚涌','太古','西灣河','筲箕灣','柴灣',
  '尖沙咀','尖東','佐敦','油麻地',
  '旺角','太子','大角咀',
  '長沙灣','荔枝角','美孚',
  '土瓜灣','紅磡','何文田','啟德',
  '九龍灣','觀塘','牛頭角','藍田','油塘',
  '深井','馬灣','荃灣',
  '屯門','黃金海岸',
  '元朗','天水圍','錦田',
  '上水','粉嶺',
  '大埔',
  '沙田','大圍','火炭',
  '西貢','將軍澳','坑口','寶琳','調景嶺','康城','清水灣',
  '葵涌','葵芳','青衣',
  '東涌','愉景灣','迪士尼','機場','大澳','長洲','南丫島','坪洲',
];

const ALIAS_GROUPS: Array<{ names: string[]; keys: string[] }> = [
  { names: ['奧運','olympic','olympian'], keys: ['奧海城','海泓道','大角咀','利奧坊','海帆道','匯翔道','櫻桃街','奧柏'] },
  { names: ['旺角東'], keys: ['旺角','太子'] },
  { names: ['西九龍','west kowloon','elements','圓方'], keys: ['西九龍','柯士甸','圓方','elements'] },
  { names: ['科學園','science park'], keys: ['科學園','白石角'] },
  { names: ['數碼港','cyberport'], keys: ['數碼港','薄扶林'] },
  { names: ['太古'], keys: ['太古','鰂魚涌'] },
  { names: ['將軍澳'], keys: ['將軍澳','坑口','寶琳','調景嶺','康城'] },
  { names: ['東涌'], keys: ['東涌','愉景灣'] },
  { names: ['馬鞍山'], keys: ['馬鞍山','烏溪沙'] },
  { names: ['機場','airport'], keys: ['機場','赤鱲角','航天城'] },
  { names: ['迪士尼','disneyland'], keys: ['迪士尼','竹篙灣'] },
  { names: ['中文大學','cuhk'], keys: ['中文大學','馬料水'] },
  { names: ['香港科技大學','hkust'], keys: ['香港科技大學','清水灣'] },
  { names: ['香港大學','hku'], keys: ['香港大學','薄扶林'] },
  { names: ['海洋公園','ocean park'], keys: ['海洋公園','黃竹坑'] },
  { names: ['黃金海岸','gold coast'], keys: ['黃金海岸','青山公路'] },
  { names: ['天水圍'], keys: ['天水圍','天慈'] },
];

// Display-name mapping (English) for area-centre keys. Used only for the area
// header label so e.g. "奧運" reads as "Olympic" in the EN UI. Fallback is the
// raw CJK key when no mapping exists.
//
// Sourced from src/data/area-names.json (single source of truth shared with
// /en/restaurants/area/[slug] page). Also injects extra aliases (e.g. 圓方 →
// Elements) and English-language abbreviations used commonly by EN users:
//   tst → 尖沙咀 (Tsim Sha Tsui)
//   tko → 將軍澳 (Tseung Kwan O)
//   cwb → 銅鑼灣 (Causeway Bay)
const AREA_NAME_EN: Record<string, string> = Object.fromEntries(
  Object.entries(areaNames as Record<string, { en: string }>).map(([zh, v]) => [zh, v.en])
);
// Non-centre aliases (not in centres map). Add to the lookup table so the EN
// header / search bar can show their canonical English name when matched.
AREA_NAME_EN['圓方'] = 'Elements';

// Reverse map used by the client to detect an English name query (e.g.
// "Tsim Sha Tsui") and turn it into the zh area-centre key. Built from
// AREA_NAME_EN, so adding a name to area-names.json is enough to make it
// searchable. Abbreviations are appended at the end (longer names win).
const AREA_NAME_EN_REVERSE: Record<string, string> = (() => {
  const out: Record<string, string> = {};
  for (const [zh, en] of Object.entries(AREA_NAME_EN)) {
    if (!en) continue;
    out[en.toLowerCase()] = zh;
  }
  // Abbreviations (common EN shorthand; only used when user types them).
  out['tst'] = '尖沙咀';
  out['tko'] = '將軍澳';
  out['cwb'] = '銅鑼灣';
  return out;
})();
// Sort longest-first so multi-word names match before abbreviations.
const AREA_NAME_EN_SORTED = Object.keys(AREA_NAME_EN_REVERSE).sort((a, b) => b.length - a.length);

function detectSubAreasFromBase(baseLower: string): string[] {
  const hits: string[] = [];
  for (const s of SUB_AREAS) {
    if (baseLower.includes(s)) hits.push(s);
  }
  return hits;
}

function detectAliasesFromBase(baseLower: string): string[] {
  const hits: string[] = [];
  for (const g of ALIAS_GROUPS) {
    if (g.keys.some(k => baseLower.includes(k))) {
      for (const n of g.names) hits.push(n);
    }
  }
  return hits;
}

function buildSearchKey(r: any): string {
  const base = [r.name_zh || '', r.name_en || '', r.address || '', r.district || '']
    .join(' ')
    .toLowerCase();
  const extras = [...detectSubAreasFromBase(base), ...detectAliasesFromBase(base)];
  const seen = new Set<string>();
  const merged: string[] = [];
  for (const x of extras) {
    if (!seen.has(x)) { seen.add(x); merged.push(x); }
  }
  return base + ' ' + merged.join(' ');
}

// Coords lookup: prefer the building-level CSDI coords; fall back to null
// if the record has no usable lat/lng.
function coordsFor(id: number | string): { lat: number; lng: number; prec: string } | null {
  const c = restaurantCoords[String(id)] as { lat?: number; lng?: number; prec?: string } | undefined;
  if (!c || c.lat == null || c.lng == null) return null;
  return { lat: c.lat, lng: c.lng, prec: c.prec || 'building' };
}

type StaticCard = { id: number; name_zh: string; name_en: string; district: string; address: string; key: string; lat: number | null; lng: number | null; prec: string | null };
// Island row: [id, name_zh, name_en, district, address, extras, lat, lng, prec]
// lat/lng are null when no usable coords; prec is 'building'|'street'|'area'|null.
type IslandRow = [number, string, string, string, string, string, number | null, number | null, string | null];

const firstPage: StaticCard[] = (restaurants as any[]).slice(0, STATIC_COUNT).map((r: any) => {
  const c = coordsFor(r.id);
  return {
    id: r.id,
    name_zh: r.name_zh || r.name_en || '',
    name_en: r.name_en || r.name_zh || '',
    district: r.district || '',
    address: r.address || '',
    key: buildSearchKey(r),
    lat: c ? c.lat : null,
    lng: c ? c.lng : null,
    prec: c ? c.prec : null,
  };
});

const restData: IslandRow[] = (restaurants as any[]).slice(STATIC_COUNT).map((r: any) => {
  const base = [r.name_zh || '', r.name_en || '', r.address || '', r.district || ''].join(' ').toLowerCase();
  const extras = [...detectSubAreasFromBase(base), ...detectAliasesFromBase(base)];
  const seen = new Set<string>();
  const merged: string[] = [];
  for (const x of extras) {
    if (!seen.has(x)) { seen.add(x); merged.push(x); }
  }
  const c = coordsFor(r.id);
  return [r.id, r.name_zh || r.name_en || '', r.name_en || r.name_zh || '', r.district || '', r.address || '', merged.join(' '), c ? c.lat : null, c ? c.lng : null, c ? c.prec : null];
});
---

<BaseLayout title="🍽️ Restaurants" lang="en">
  <div class="max-w-4xl mx-auto px-4 py-6 md:py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-3">
        <h1 class="text-xl md:text-2xl font-bold text-near-black">🍽️ Dog-friendly Restaurants</h1>
        <span class="text-sm text-gray-500 bg-gray-50 px-2.5 py-0.5 rounded-full" id="result-count">{restaurants.length} venues</span>
      </div>
      <a href="/en/restaurants" class="text-xs text-gray-500 hover:text-brand no-underline hidden" id="clear-filter">Clear filters</a>
    </div>

    <!-- Search bar -->
    <div class="flex gap-2 mb-5">
      <div class="flex-1 flex gap-2">
        <input type="text" id="search-input" placeholder="Search restaurant, area..."
          class="flex-1 min-w-0 px-3.5 py-2 text-sm border border-gray-100 rounded-lg outline-none focus:border-brand/50 bg-white"
        />
        <button onclick="filterList()" class="bg-brand text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700 transition-colors shrink-0">🔍</button>
      </div>
    </div>

    <!-- District pills -->
    <div class="overflow-x-auto -mx-4 px-4 mb-5 scrollbar-hide">
      <div class="flex gap-2.5 w-max md:w-auto md:flex-wrap">
        <a href="/en/restaurants" onclick="setDistrict(''); return false;"
          class="shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-brand text-white"
          id="pill-all">All</a>
        {districts.map((d: string) => (
          <a href={`/en/restaurants?district=${encodeURIComponent(d)}`} onclick={`setDistrict('${d}'); return false;`}
            class="shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
            id={`pill-${d.replace(/\s/g, '')}`}
          >{d}</a>
        ))}
      </div>
    </div>

    <!-- Area-aware "nearest first" header. Hidden by default; client toggles
         visibility when the query matches an area-centre key. -->
    <div id="area-header" class="hidden mb-3 flex flex-col gap-2">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="inline-flex items-center gap-1.5 bg-brand/10 text-brand px-2.5 py-1 rounded-full text-xs font-medium">
          <span>📍</span><span id="area-header-label">—</span>
        </span>
        <span class="text-xs text-gray-500" id="area-header-meta">—</span>
      </div>
      <div class="flex gap-2 flex-wrap" id="area-radius-chips">
        <a href="#" onclick="setRadius(-1); return false;"
          title="Default: area matches first, then auto-adds everything within 1 km of the area centre (scope expands)"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-brand text-white"
          data-radius="-1">Default (area + 1 km)</a>
        <a href="#" onclick="setRadius(500); return false;"
          title="Strict: only venues within 500 m of the area centre"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="500">500 m</a>
        <a href="#" onclick="setRadius(1000); return false;"
          title="Strict: only venues within 1 km of the area centre"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="1000">1 km</a>
        <a href="#" onclick="setRadius(2000); return false;"
          title="Strict: only venues within 2 km of the area centre"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="2000">2 km</a>
        <a href="#" onclick="setRadius(0); return false;"
          title="No scope limit: every licensed venue in Hong Kong (no distance or district filter)"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="0">All HK</a>
      </div>
      <p class="text-xs text-gray-400 mt-1 leading-relaxed" id="area-radius-legend">
        📏 All distances are measured from the <b>area centre</b> (not your location). <b>Default</b> = area matches <b>+ everything within 1 km of the centre</b> (so you will see venues outside the area; a divider in the list marks where the auto-added part starts). Pick 500 m / 1 km / 2 km for strict distance only.
      </p>
      <a href="#" id="area-page-link" class="hidden text-xs text-brand hover:underline mt-0.5">View this area page →</a>
    </div>

    <!-- Results list — first 50 are server-rendered for SEO; rest are JS-rendered into this same wrapper -->
    <div id="restaurant-list" class="flex flex-col gap-2">
      {firstPage.map((r: StaticCard) => (
        <a href={`/en/restaurants/${r.id}`}
          class="restaurant-item group bg-white rounded-xl px-4 py-3 border border-gray-100 hover:border-brand/30 hover:shadow-sm transition-all no-underline"
          data-name={(r.name_en || r.name_zh || '').toLowerCase()}
          data-district={r.district}
          data-addr={(r.address || '').toLowerCase()}
          data-key={r.key}
          data-lat={r.lat == null ? '' : r.lat}
          data-lng={r.lng == null ? '' : r.lng}
          data-prec={r.prec == null ? '' : r.prec}
        >
          <div class="flex items-center gap-3">
            <div class="w-1 h-10 bg-brand/20 rounded-full shrink-0"></div>
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold text-sm md:text-base text-near-black group-hover:text-brand transition-colors font-display" style="white-space:normal">{r.name_en || r.name_zh}</h3>
              {(() => {
                const t = restaurantTypes[String(r.id)];
                if (!t || !t.types || t.types.length === 0) return null;
                const labels = t.types.map((z: string) => CUISINE_EN_MAP[z] || z).join(' / ');
                const tip = t.source === 'osm' ? 'Source: OpenStreetMap' : 'Inferred from the shop name';
                return (
                  <p class="text-[10px] mt-0.5 truncate flex items-center gap-1">
                    <span class="inline-flex items-center bg-gray-50 text-gray-500 px-2 py-0.5 rounded-full font-medium whitespace-nowrap" title={tip}>{labels}</span>
                  </p>
                );
              })()}
              <p class="text-xs text-gray-500 mt-0.5 truncate">
                <span class="inline-flex items-center gap-1">
                  <span class="text-gray-300">📍</span>
                  <span class="sub-area-label">{r.district}</span>
                </span>
                <span class="mx-1.5 text-gray-200">·</span><span class="text-gray-300">{r.address}</span>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="dist-badge text-xs text-gray-400 hidden whitespace-nowrap"></span>
              <span class="text-gray-300 group-hover:text-brand transition-colors">
                <span class="text-xs">→</span>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Pagination UI -->
    <nav id="pager" class="flex items-center justify-center gap-1 mt-6 text-sm select-none" aria-label="Restaurant pagination">
      <button id="pg-prev" type="button" class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-500 hover:border-brand/40 disabled:opacity-30 disabled:cursor-not-allowed" disabled>← Prev</button>
      <span id="pg-info" class="px-2 text-gray-500"><span id="pg-current">1</span> / <span id="pg-total">19</span></span>
      <button id="pg-next" type="button" class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-500 hover:border-brand/40 disabled:opacity-30 disabled:cursor-not-allowed">Next →</button>
    </nav>

    <!-- Empty state -->
    <div id="empty-state" class="text-center py-16 text-gray-500 hidden">
      <div class="text-4xl mb-3">🔍</div>
      <p class="text-sm">No matching restaurants</p>
      <a href="/en/restaurants" onclick="resetFilter(); return false;" class="text-brand text-sm hover:underline mt-2 inline-block">Clear filters and search again</a>
    </div>
  </div>

  <!-- fix/restaurant-search-v2: data island for JS pagination. Compact array form
       [id, name_zh, name_en, district, address, extras, lat, lng, prec] —
       mirrors zh version 1:1. -->
  <script type="application/json" id="rest-data" set:html={JSON.stringify({ restaurants: restData })} />

  <!-- Area centre table — mirrors zh -->
  <script type="application/json" id="area-centres" set:html={JSON.stringify(areaCentres)} />
  <!-- fix/radius-chips-honest: zh-name → english-slug map for area-page links. -->
  <script type="application/json" id="area-slugs" set:html={JSON.stringify(areaSlugs)} />
  <!-- fix/area-labels-en-names: lowercase EN-name → zh-key reverse map. Read by
       client JS to detect activeArea from English queries. Includes user-facing
       abbreviations (tst/tko/cwb). Keys are lowercased before serving. -->
  <script type="application/json" id="area-names-en" set:html={JSON.stringify(
    Object.fromEntries(
      Object.entries(AREA_NAME_EN_REVERSE).map(([en, zh]) => [en.toLowerCase(), zh])
    )
  )} />
  <!-- feat/restaurant-types: id → {types:[zh,...]} map; mirrored to EN for
       JS-rendered cards. The EN chip uses CUISINE_EN_MAP to translate. -->
  <script type="application/json" id="restaurant-types" set:html={JSON.stringify(restaurantTypes)} />

  <script is:inline>
  // Sub-area names used to compute the search key (kept in sync with SSR).
  var SUB_AREAS = [
    '馬鞍山','科學園','白石角',
    '香港仔','黃竹坑','海洋公園','淺水灣','赤柱','薄扶林','數碼港','鴨脷洲',
    '中環','上環','西營盤','堅尼地城','石塘咀','半山','山頂','金鐘',
    '銅鑼灣','跑馬地','大坑','天后',
    '北角','鰂魚涌','太古','西灣河','筲箕灣','柴灣',
    '尖沙咀','尖東','佐敦','油麻地',
    '旺角','太子','大角咀',
    '長沙灣','荔枝角','美孚',
    '土瓜灣','紅磡','何文田','啟德',
    '九龍灣','觀塘','牛頭角','藍田','油塘',
    '深井','馬灣','荃灣',
    '屯門','黃金海岸',
    '元朗','天水圍','錦田',
    '上水','粉嶺',
    '大埔',
    '沙田','大圍','火炭',
    '西貢','將軍澳','坑口','寶琳','調景嶺','康城','清水灣',
    '葵涌','葵芳','青衣',
    '東涌','愉景灣','迪士尼','機場','大澳','長洲','南丫島','坪洲',
  ];

  // Display-name mapping (English) for area-centre keys. SSR used the CJK
  // label; the EN UI shows the English equivalent when known. Fallback to the
  // raw CJK key when no mapping is found.
  var AREA_NAME_EN = {
    '奧運': 'Olympic',
    '旺角': 'Mong Kok',
    '旺角東': 'Mong Kok East',
    '太子': 'Prince Edward',
    '大角咀': 'Tai Kok Tsui',
    '西九龍': 'West Kowloon',
    '圓方': 'Elements',
    '尖沙咀': 'Tsim Sha Tsui',
    '尖東': 'Tsim Sha Tsui East',
    '佐敦': 'Jordan',
    '油麻地': 'Yau Ma Tei',
    '中環': 'Central',
    '上環': 'Sheung Wan',
    '西營盤': 'Sai Ying Pun',
    '堅尼地城': 'Kennedy Town',
