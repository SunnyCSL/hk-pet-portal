  '葵涌': 'Kwai Chung',
  '葵芳': 'Kwai Fong',
  '青衣': 'Tsing Yi',
  '東涌': 'Tung Chung',
  '愉景灣': 'Discovery Bay',
  '迪士尼': 'Hong Kong Disneyland',
  '機場': 'Airport',
  '大澳': 'Tai O',
  '長洲': 'Cheung Chau',
  '南丫島': 'Lamma Island',
  '坪洲': 'Peng Chau',
  '馬鞍山': 'Ma On Shan',
  '科學園': 'Science Park',
  '白石角': 'Pak Shek Kok',
