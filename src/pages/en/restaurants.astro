function detectSubAreasFromBase(baseLower: string): string[] {
  const hits: string[] = [];
  for (const s of SUB_AREAS) {
    if (baseLower.includes(s)) hits.push(s);
  }
  return hits;
}

function detectAliasesFromBase(baseLower: string): string[] {
  const hits: string[] = [];
  for (const g of ALIAS_GROUPS) {
    if (g.keys.some(k => baseLower.includes(k))) {
      for (const n of g.names) hits.push(n);
    }
  }
  return hits;
}

function buildSearchKey(r: any): string {
  const base = [r.name_zh || '', r.name_en || '', r.address || '', r.district || '']
    .join(' ')
    .toLowerCase();
  const extras = [...detectSubAreasFromBase(base), ...detectAliasesFromBase(base)];
  const seen = new Set<string>();
  const merged: string[] = [];
  for (const x of extras) {
    if (!seen.has(x)) { seen.add(x); merged.push(x); }
  }
  return base + ' ' + merged.join(' ');
}

// Coords lookup: prefer the building-level CSDI coords; fall back to null
// if the record has no usable lat/lng.
function coordsFor(id: number | string): { lat: number; lng: number; prec: string } | null {
  const c = restaurantCoords[String(id)] as { lat?: number; lng?: number; prec?: string } | undefined;
  if (!c || c.lat == null || c.lng == null) return null;
  return { lat: c.lat, lng: c.lng, prec: c.prec || 'building' };
}

type StaticCard = { id: number; name_zh: string; name_en: string; district: string; address: string; key: string; lat: number | null; lng: number | null; prec: string | null };
// Island row: [id, name_zh, name_en, district, address, extras, lat, lng, prec]
// lat/lng are null when no usable coords; prec is 'building'|'street'|'area'|null.
type IslandRow = [number, string, string, string, string, string, number | null, number | null, string | null];

const firstPage: StaticCard[] = (restaurants as any[]).slice(0, STATIC_COUNT).map((r: any) => {
  const c = coordsFor(r.id);
  return {
    id: r.id,
    name_zh: r.name_zh || r.name_en || '',
    name_en: r.name_en || r.name_zh || '',
    district: r.district || '',
    address: r.address || '',
    key: buildSearchKey(r),
    lat: c ? c.lat : null,
    lng: c ? c.lng : null,
    prec: c ? c.prec : null,
  };
});

const restData: IslandRow[] = (restaurants as any[]).slice(STATIC_COUNT).map((r: any) => {
  const base = [r.name_zh || '', r.name_en || '', r.address || '', r.district || ''].join(' ').toLowerCase();
  const extras = [...detectSubAreasFromBase(base), ...detectAliasesFromBase(base)];
  const seen = new Set<string>();
  const merged: string[] = [];
  for (const x of extras) {
    if (!seen.has(x)) { seen.add(x); merged.push(x); }
  }
  const c = coordsFor(r.id);
  return [r.id, r.name_zh || r.name_en || '', r.name_en || r.name_zh || '', r.district || '', r.address || '', merged.join(' '), c ? c.lat : null, c ? c.lng : null, c ? c.prec : null];
});
---

<BaseLayout title="🍽️ Restaurants" lang="en">
  <div class="max-w-4xl mx-auto px-4 py-6 md:py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-3">
        <h1 class="text-xl md:text-2xl font-bold text-near-black">🍽️ Dog-friendly Restaurants</h1>
        <span class="text-sm text-gray-500 bg-gray-50 px-2.5 py-0.5 rounded-full" id="result-count">{restaurants.length} venues</span>
      </div>
      <a href="/en/restaurants" class="text-xs text-gray-500 hover:text-brand no-underline hidden" id="clear-filter">Clear filters</a>
    </div>

    <!-- Search bar -->
    <div class="flex gap-2 mb-5">
      <div class="flex-1 flex gap-2">
        <input type="text" id="search-input" placeholder="Search restaurant, area..."
          class="flex-1 min-w-0 px-3.5 py-2 text-sm border border-gray-100 rounded-lg outline-none focus:border-brand/50 bg-white"
        />
        <button onclick="filterList()" class="bg-brand text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700 transition-colors shrink-0">🔍</button>
      </div>
    </div>

    <!-- District pills -->
    <div class="overflow-x-auto -mx-4 px-4 mb-5 scrollbar-hide">
      <div class="flex gap-1.5 w-max md:w-auto md:flex-wrap">
        <a href="/en/restaurants" onclick="setDistrict(''); return false;"
          class="shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-brand text-white"
          id="pill-all">All</a>
        {districts.map((d: string) => (
          <a href={`/en/restaurants?district=${encodeURIComponent(d)}`} onclick={`setDistrict('${d}'); return false;`}
            class="shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
            id={`pill-${d.replace(/\s/g, '')}`}
          >{d}</a>
        ))}
      </div>
    </div>

    <!-- Area-aware "nearest first" header. Hidden by default; client toggles
         visibility when the query matches an area-centre key. -->
    <div id="area-header" class="hidden mb-3 flex flex-col gap-2">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="inline-flex items-center gap-1.5 bg-brand/10 text-brand px-2.5 py-1 rounded-full text-xs font-medium">
          <span>📍</span><span id="area-header-label">—</span>
        </span>
        <span class="text-xs text-gray-500" id="area-header-meta">—</span>
      </div>
      <div class="flex gap-1.5 flex-wrap" id="area-radius-chips">
        <a href="#" onclick="setRadius(500); return false;"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="500">500 m</a>
        <a href="#" onclick="setRadius(1000); return false;"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="1000">1 km</a>
        <a href="#" onclick="setRadius(2000); return false;"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="2000">2 km</a>
        <a href="#" onclick="setRadius(0); return false;"
          class="radius-chip shrink-0 px-2.5 py-1 rounded-full text-xs font-medium transition-all no-underline whitespace-nowrap bg-gray-50 text-gray-500 hover:bg-gray-100"
          data-radius="0">All</a>
      </div>
    </div>

    <!-- Results list — first 50 are server-rendered for SEO; rest are JS-rendered into this same wrapper -->
    <div id="restaurant-list" class="flex flex-col gap-2">
      {firstPage.map((r: StaticCard) => (
        <a href={`/en/restaurants/${r.id}`}
          class="restaurant-item group bg-white rounded-xl px-4 py-3 border border-gray-100 hover:border-brand/30 hover:shadow-sm transition-all no-underline"
          data-name={(r.name_en || r.name_zh || '').toLowerCase()}
          data-district={r.district}
          data-addr={(r.address || '').toLowerCase()}
          data-key={r.key}
          data-lat={r.lat == null ? '' : r.lat}
          data-lng={r.lng == null ? '' : r.lng}
          data-prec={r.prec == null ? '' : r.prec}
        >
          <div class="flex items-center gap-3">
            <div class="w-1 h-10 bg-brand/20 rounded-full shrink-0"></div>
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold text-sm md:text-base text-near-black group-hover:text-brand transition-colors truncate">{r.name_en || r.name_zh}</h3>
              <p class="text-xs text-gray-500 mt-0.5 truncate">
                <span class="inline-flex items-center gap-1">
                  <span class="text-gray-300">📍</span>
                  <span class="sub-area-label">{r.district}</span>
                </span>
                <span class="mx-1.5 text-gray-200">·</span><span class="text-gray-300">{r.address}</span>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="dist-badge text-xs text-gray-400 hidden whitespace-nowrap"></span>
              <span class="text-gray-300 group-hover:text-brand transition-colors">
                <span class="text-xs">→</span>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Pagination UI -->
    <nav id="pager" class="flex items-center justify-center gap-1 mt-6 text-sm select-none" aria-label="Restaurant pagination">
      <button id="pg-prev" type="button" class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-500 hover:border-brand/40 disabled:opacity-30 disabled:cursor-not-allowed" disabled>← Prev</button>
      <span id="pg-info" class="px-2 text-gray-500"><span id="pg-current">1</span> / <span id="pg-total">19</span></span>
      <button id="pg-next" type="button" class="px-3 py-1.5 rounded-lg border border-gray-100 text-gray-500 hover:border-brand/40 disabled:opacity-30 disabled:cursor-not-allowed">Next →</button>
    </nav>

    <!-- Empty state -->
    <div id="empty-state" class="text-center py-16 text-gray-500 hidden">
      <div class="text-4xl mb-3">🔍</div>
      <p class="text-sm">No matching restaurants</p>
      <a href="/en/restaurants" onclick="resetFilter(); return false;" class="text-brand text-sm hover:underline mt-2 inline-block">Clear filters and search again</a>
    </div>
  </div>

  <!-- fix/restaurant-search-v2: data island for JS pagination. Compact array form
       [id, name_zh, name_en, district, address, extras, lat, lng, prec] —
       mirrors zh version 1:1. -->
  <script type="application/json" id="rest-data" set:html={JSON.stringify({ restaurants: restData })} />

  <!-- Area centre table — mirrors zh -->
  <script type="application/json" id="area-centres" set:html={JSON.stringify(areaCentres)} />

