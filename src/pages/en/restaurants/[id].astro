---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import restaurants from '../../../data/restaurants.json';
import coords from '../../../data/restaurant-coords.json';
import restaurantTypes from '../../../data/restaurant-types.json';

// feat/restaurant-types: zh category → en display name (mirrors /tmp/cuisine_rules.md).
const CUISINE_EN_MAP: Record<string, string> = {
  '咖啡': 'Coffee', '酒吧': 'Bar', '茶飲': 'Bubble tea',
  '茶餐廳': 'Cha chaan teng', '港式大排檔': 'Dai pai dong',
  '港式燒味': 'Cantonese roast', '火鍋': 'Hot pot', '點心': 'Dim sum',
  '壽司／刺身': 'Sushi & sashimi', '拉麵／烏冬': 'Ramen & udon',
  '日式': 'Japanese', '日式燒肉': 'Yakiniku', '韓式': 'Korean',
  '泰越星馬': 'Thai / Viet / SEA', '西餐': 'Western', '法式': 'French',
  '中菜': 'Chinese', '中式地方菜': 'Regional Chinese', '粉麵': 'Noodles',
  '粥品': 'Congee', '海鮮': 'Seafood', '串燒燒烤': 'Skewers & BBQ',
  '素食': 'Vegetarian', '甜品／烘焙': 'Dessert & bakery',
  '印度尼泊爾': 'Indian & Nepali', '台灣': 'Taiwanese'
};

export async function getStaticPaths() {
  return restaurants.map((r: { id: number }) => ({
    params: { id: String(r.id) },
    props: { restaurant: r },
  }));
}

const { id } = Astro.params;
const { restaurant } = Astro.props;

if (!restaurant) {
  return Astro.redirect('/404');
}

// Related restaurants (same district, random 3)
const related = restaurants
  .filter((r: { id: number; district: string }) => r.district === restaurant.district && r.id !== restaurant.id)
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);

// English-first display name. Falls back to Chinese when no English translation
// has been recorded yet — still surfaces a useful page to English users.
const displayName = restaurant.name_en || restaurant.name_zh || `${restaurant.district} dog-friendly restaurant`;
const fallbackZhName = restaurant.name_zh && restaurant.name_zh !== restaurant.name_en ? restaurant.name_zh : '';

// Get pre-geocoded coordinates from HK Gov API
const restCoords = coords[restaurant.id] || null;
const restLat = restCoords?.lat || 22.3193;
const restLng = restCoords?.lng || 114.1694;

const cuisine = restaurantTypes[String(restaurant.id)];
const cuisineList = cuisine && cuisine.types && cuisine.types.length
  ? cuisine.types.map((z: string) => CUISINE_EN_MAP[z] || z).join(' / ')
  : '';
const cuisineTip = cuisine?.source === 'osm' ? 'Source: OpenStreetMap' : 'Inferred from the shop name';

const gmapsHref = `https://www.google.com/maps/search/${encodeURIComponent(restaurant.address + ' Hong Kong')}`;
const openRiceHref = `https://www.openrice.com/en/hongkong/restaurants?where=${encodeURIComponent((restaurant.name_en || restaurant.name_zh || '').trim())}`;
---

<BaseLayout title={displayName} lang="en">
  <div class="rd-wrap">

    <!-- Back link -->
    <a href="/en/restaurants" class="rd-back">← Back to restaurant list</a>

    <!-- ── Hero ───────────────────────────────────────────────────── -->
    <header class="rd-head">
      <h1 class="rd-title font-display">{displayName}</h1>
      {fallbackZhName && <p class="rd-sub">{fallbackZhName}</p>}
      <div class="rd-chips">
        <span class="rd-chip rd-chip-area">
          📍 <span class="sub-area-label" data-addr={restaurant.address} data-name={displayName}>{restaurant.district}</span>
        </span>
        <span class="rd-chip">🐾 Dog-friendly</span>
        {cuisineList && <span class="rd-chip" title={cuisineTip}>🍽️ {cuisineList}</span>}
      </div>
    </header>

    <!-- ── Card + map fused ───────────────────────────────────────── -->
    <section class="rd-card" aria-label="Venue details">
      <div id="restaurant-map" class="rd-map"
           data-lat={restLat} data-lng={restLng}
           data-name={displayName} data-address={restaurant.address}></div>

      <div class="rd-rows">
        <div class="rd-row">
          <div class="rd-label">Address</div>
          <div class="rd-value">{restaurant.address}</div>
        </div>
        <div class="rd-row">
          <div class="rd-label">District</div>
          <div class="rd-value">{restaurant.district}</div>
        </div>
        {cuisineList && (
          <div class="rd-row">
            <div class="rd-label">Type</div>
            <div class="rd-value" title={cuisineTip}>{cuisineList}</div>
          </div>
        )}
        <div class="rd-row">
          <div class="rd-label">Licence</div>
          <div class="rd-value rd-license">
            <span class="rd-license-no">{restaurant.license_no}</span>
            <span class="rd-badge-ok">✓ FEHD licensed for dogs</span>
          </div>
        </div>
      </div>

      <div class="rd-actions">
        <a class="btn btn-primary rd-cta" href={gmapsHref} target="_blank" rel="noopener">
          🗺️ Directions on Google Maps
        </a>
        <a class="btn btn-outline rd-cta" href={openRiceHref} target="_blank" rel="noopener">
          📖 Read reviews on OpenRice
        </a>
      </div>

      <p class="rd-src">
        Licence data from the FEHD public list ·
        <a href="https://www.fehd.gov.hk/english/licensing/dog_restaurants/dog_restaurants_list.html"
           target="_blank" rel="noopener">Official list ↗</a>
      </p>
    </section>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>
    <script src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.1.0/leaflet-maplibre-gl.js" is:inline></script>
    <script src="/basemap.js" is:inline></script>
    <script is:inline>
    var SUB_AREAS = ['馬鞍山','科學園','白石角','香港仔','黃竹坑','海洋公園','淺水灣','赤柱','薄扶林','數碼港','鴨脷洲','中環','上環','西營盤','堅尼地城','石塘咀','半山','山頂','金鐘','銅鑼灣','跑馬地','大坑','天后','北角','鰂魚涌','太古','西灣河','筲箕灣','柴灣','尖沙咀','尖東','佐敦','油麻地','旺角','太子','大角咀','長沙灣','荔枝角','美孚','土瓜灣','紅磡','何文田','啟德','九龍灣','觀塘','牛頭角','藍田','油塘','深井','馬灣','荃灣','屯門','黃金海岸','元朗','天水圍','錦田','上水','粉嶺','大埔','沙田','大圍','火炭','西貢','將軍澳','坑口','寶琳','調景嶺','康城','清水灣','葵涌','葵芳','青衣','東涌','愉景灣','迪士尼','機場','大澳','長洲','南丫島','坪洲'];
    document.querySelectorAll('.sub-area-label').forEach(function(el) {
      var addr = el.getAttribute('data-addr') || '';
      var name = el.getAttribute('data-name') || '';
      var combined = addr + ' ' + name;
      for (var i = 0; i < SUB_AREAS.length; i++) {
        if (combined.indexOf(SUB_AREAS[i]) !== -1) {
          el.textContent = SUB_AREAS[i];
          break;
        }
      }
    });
    document.addEventListener('DOMContentLoaded', function() {
      var mapEl = document.getElementById('restaurant-map');
      if (!mapEl || typeof L === 'undefined') { console.log('Leaflet not loaded'); return; }

      var lat = parseFloat(mapEl.getAttribute('data-lat')) || 22.3193;
      var lng = parseFloat(mapEl.getAttribute('data-lng')) || 114.1694;
      var name = mapEl.getAttribute('data-name') || '';
      var address = mapEl.getAttribute('data-address') || '';

      var map = L.map(mapEl, {
        center: [lat, lng],
        zoom: 16,
        zoomControl: true,
        scrollWheelZoom: true
      });

      NexiBasemap.add(map);
      L.marker([lat, lng]).addTo(map);

      setTimeout(function() { map.invalidateSize(); }, 200);
    });
    </script>

    <!-- Related restaurants -->
    {related.length > 0 && (
      <div class="rd-related">
        <h2 class="rd-related-title">Other dog-friendly venues in {restaurant.district}</h2>
        <div class="rd-related-list">
          {related.map((r: { id: number; name_zh: string; name_en: string; district: string }) => (
            <a href={`/en/restaurants/${r.id}`} class="rd-related-item">
              <span class="rd-related-name">{r.name_en || r.name_zh}</span>
              <span class="rd-related-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
